    "allowed_commands": [
      {
        "command": "rg",
        "mode": "read-only",
        "purpose": "search-allowed-paths"
      },
      {
        "command": "sed",
        "mode": "read-only",
        "purpose": "view-selected-lines"
      }
    ],
    "network": false,
