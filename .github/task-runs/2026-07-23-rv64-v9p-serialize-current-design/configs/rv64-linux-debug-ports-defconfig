# V9P Linux stall diagnostic: keep the Linux functional profile while
# exporting RTL owner/bus observation ports. Per-cycle aggregate statistics
# are disabled so the 300M-cycle diagnostic reaches the stop point sooner.
CONFIG_CC_GPP=y
CONFIG_CC="g++"
CONFIG_CC_O3=y
CONFIG_CC_OPT="-O3"
CONFIG_CC_DEBUG=n
CONFIG_NPC_DEFAULT_MAX_CYCLES=100000000
CONFIG_NPC_DEFAULT_LOG_PATH="build/linux-logs/npc-linux-debug-ports.log"
CONFIG_NPC_BATCH_MODE=y
CONFIG_NPC_STDIN_KEYBOARD=n
CONFIG_NPC_HAS_VGA=n
CONFIG_NPC_TRACE_BY_DEFAULT=n
CONFIG_NPC_COLORED_LOG=y
CONFIG_NPC_LOG_FILE=y
CONFIG_NPC_PROGRESS_BY_DEFAULT=y
CONFIG_NPC_DEFAULT_PROGRESS_INTERVAL=10000000
CONFIG_NPC_DIFFTEST=n
CONFIG_NPC_SDB=n
CONFIG_NPC_EXPR=n
CONFIG_NPC_WATCHPOINT=n
CONFIG_NPC_TEXT_TRACE=n
CONFIG_NPC_SIM_STATS=n
CONFIG_NPC_DEBUG_PORTS=y
