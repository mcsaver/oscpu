__NEMU_GUEST_CHECK_B64__
if ! command -v base64 >/dev/null 2>&1 || ! command -v sha256sum >/dev/null 2>&1; then
  echo "__NEMU_GUEST_SCRIPT_TOOL_MISSING__"
  echo "__NEMU_SYSTEMD_CHECK_DONE__ rc=1"
elif ! base64 -d '/tmp/nemu-systemd-guest-check.sh.b64' > '/tmp/nemu-systemd-guest-check.sh'; then
  echo "__NEMU_GUEST_SCRIPT_DECODE_FAIL__"
  echo "__NEMU_SYSTEMD_CHECK_DONE__ rc=1"
else
  guest_script_sha="$(sha256sum '/tmp/nemu-systemd-guest-check.sh' 2>/dev/null | awk '{print $1}')"
  guest_script_bytes="$(wc -c < '/tmp/nemu-systemd-guest-check.sh' 2>/dev/null || echo 0)"
  echo "__NEMU_GUEST_SCRIPT_BYTES__:$guest_script_bytes/157064"
  echo "__NEMU_GUEST_SCRIPT_SHA256__:$guest_script_sha/fecdd93f92a1c745fd54b46db35e9ebe9a6f478dc0dd856e5122f63f3e02ba1a"
  if [ "$guest_script_sha" = 'fecdd93f92a1c745fd54b46db35e9ebe9a6f478dc0dd856e5122f63f3e02ba1a' ] && [ "$guest_script_bytes" = '157064' ]; then
    echo "__NEMU_GUEST_SCRIPT_READY__"
    sh '/tmp/nemu-systemd-guest-check.sh'
  else
    echo "__NEMU_GUEST_SCRIPT_SHA256_FAIL__"
    echo "__NEMU_SYSTEMD_CHECK_DONE__ rc=1"
  fi
fi
