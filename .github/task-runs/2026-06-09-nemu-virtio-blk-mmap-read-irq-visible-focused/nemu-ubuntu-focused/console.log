__NE> __NEMU_SYSCALL_PROBE_B64__
  >   if base64 -d "$probe_b64" > "$probe_bin" &&
>      chmod +x "$probe_bin" &&
 >      "$probe_bin" "$check_dir"; then
>     pass syscall-probe
>   else
l>     fail syscall-probe
f>   fi
se> else
cho >   echo "__NEMU_CHECK_SYSCALL_PROBE_SKIP__"

> fi
 60 &
sig_pid=$!
kill -TERM "$sig_pid" 2>/dev/null || true
wait "$sig_pid"
sig_rc=$?
echo "__NEMU_CHECK_SIGNAL_RC__:$sig_rc"
[ "$sig_rc" -gt 128 ] 2>/dev/null && pass signal-kill-wait __NEMU_SYSCALL_PROBE_BEGIN__:/root/nemu-systemd-guest-check.d
|| fail signal-kill-wait

writ__NEMU_SYSCALL_PROBE_PASS__:mmap-msync
e___NEMU_SYSCALL_PROBE_PASS__:pread-mmap-file
f__NEMU_SYSCALL_PROBE_PASS__:posix-fallocate
__NEMU_SYSCALL_PROBE_PASS__:flock
ile="$check___NEMU_SYSCALL_PROBE_PASS__:syncfs
dir__NEMU_SYSCALL_PROBE_PASS__:mremap-anon
/n__NEMU_SYSCALL_PROBE_PASS__:mprotect-readonly-page
e__NEMU_SYSCALL_PROBE_PASS__:madvise-willneed
__NEMU_SYSCALL_PROBE_PASS__:mincore-resident
mu__NEMU_SYSCALL_PROBE_PASS__:statx-dir
-systemd-__NEMU_SYSCALL_PROBE_PASS__:openat2-create-write
