+                                  `ALU_OP_ADD, 1'b1, 1'b0, 1'b1),
+                    5'd5, 5'd0, 5'd5, 64'd1);
+      #1;
+      tb_check1("R3.2 chain seed lane0 ready", dispatch0_ready, 1'b1);
+      tb_check1("R3.2 chain seed lane1 ready", dispatch1_ready, 1'b1);
