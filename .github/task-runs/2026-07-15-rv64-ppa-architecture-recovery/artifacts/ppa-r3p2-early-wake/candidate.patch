+        if (dispatched < 64) begin
+          tb_check1("R3.2 chain continuous dispatch", dispatch0_ready,
+                    1'b1);
+          if (dispatch0_ready)
+            dispatched = dispatched + 1;
+        end
+
+        if (fired < 64) begin
+          tb_check1("R3.2 chain issue0 fires", dut.issue0_fire_w, 1'b1);
