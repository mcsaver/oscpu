   memset(&g_sim_perf, 0, sizeof(g_sim_perf));
@@ -2285,4 +2362,5 @@
         const CommitEvent &event = g_commit_events[commit_idx];
         if (!event.valid) continue;
 
+        observe_region_boundary(event, commit_idx);
         ++executed;
