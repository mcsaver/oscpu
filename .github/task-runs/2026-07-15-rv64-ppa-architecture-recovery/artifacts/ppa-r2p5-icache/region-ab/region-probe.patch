 static ExitEvent   g_exit_event   = {};
 static TrapEvent   g_trap_event   = {};
+struct RegionProbeState {
+  bool start_seen;
+  bool end_seen;
+  uint64_t start_pc_hits;
+  uint64_t end_pc_hits;
+  uint64_t start_cycle;
+  uint64_t end_cycle;
