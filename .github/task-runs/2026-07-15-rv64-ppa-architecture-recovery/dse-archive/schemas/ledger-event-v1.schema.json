{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rv64-dse-ledger-event-v1",
  "type": "object",
  "required": [
    "event_schema",
    "sequence",
    "timestamp_utc",
    "event_type",
    "actor",
    "design_id",
    "previous_event_sha256",
    "payload",
    "event_sha256"
  ],
  "properties": {
    "event_schema": {"const": "rv64-dse-ledger-event-v1"},
    "sequence": {"type": "integer", "minimum": 0},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "event_type": {
      "enum": ["archive_initialized", "checkpoint_recorded", "complete_point_evaluated", "global_thaw_opened"]
    },
    "actor": {"type": "string", "minLength": 1},
    "design_id": {"type": ["string", "null"]},
    "previous_event_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "payload": {"type": "object"},
    "event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
