{
  "schema_version": 1,
  "purpose": "Workspace AI tooling policy. It records defaults and explicit assurance boundaries; it does not grant or revoke permission for safe local engineering work.",
  "operating_contract": {
    "source": ".github/AGENTS.md",
    "primary_objective_first": true,
    "acceptance_criteria_driven": true,
    "safe_local_operations_are_one_scope": true,
    "self_created_permission_gates_forbidden": true,
    "failure_driven_evidence_escalation": true,
    "compaction_recovery_order": [
      "primary_objective",
      "explicit_acceptance_criteria",
      "repository_state",
      "hard_constraints",
      "current_validation_evidence"
    ]
  },
  "layers": {
    "database": {
      "role": "optional-long-term-memory-and-persistent-run-index",
      "db": ".github/cache/github-index.sqlite",
      "backup_roots": [],
      "active_instruction_source": false
    },
    "skill": {
      "role": "reusable-advisory-methods",
      "live_roots": [
        ".github/skills"
      ],
      "may_create_permission_boundaries": false
    },
    "agent": {
      "role": "optional-execution-and-recording-tools",
      "maintainer": "scripts/agent-maintain.sh",
      "live_roots": [
        ".github/agents",
        ".codex/agents"
      ],
      "may_expand_user_authority": false
    }
  },
  "agent_tools": {
    "authority": "platform-and-user",
    "enforcement": "platform-owned",
    "workspace_allowlist_is_advisory": true,
    "allow_mcp_servers_decided_by_platform": true
  },
  "lightweight_workflow": {
    "instruction": ".github/instructions/agent-lightweight-workflow.instructions.md",
    "controller_source": "scripts/agent-flow.c",
    "controller_entry": "scripts/agent-flow.sh",
    "controller_required_for_ordinary_tasks": false,
    "state_root": ".github/runtime-artifacts/agent-flow",
    "task_classes_are_descriptive": true,
    "task_classes": [
      "review",
      "analysis",
      "docs",
      "development",
      "verification",
      "environment",
      "longrun",
      "cleanup",
      "release"
    ],
    "gate_selection": "explicit-only",
    "changed_paths_create_gates": false,
    "changed_paths_may_suggest_checks": true,
    "default_archive_mode": "none",
    "task_run_modes": [
      "none",
      "compact",
      "durable"
    ],
    "task_run_requires_explicit_selection": true,
    "zero_gate_finish_result": "FINISHED_NO_GATES",
    "zero_gate_finish_is_engineering_pass": false,
    "private_token_reasoning_archived": false
  },
  "validation_budget": {
    "policy": "acceptance-criterion-risk-and-observed-uncertainty-driven",
    "new_check_questions": [
      "which explicit acceptance criterion does this check evaluate",
      "which realistic false PASS does it uniquely detect",
      "could omitting it cause a wrong engineering conclusion"
    ],
    "versioned_verifier_default": "trusted-until-observed-anomaly",
    "deterministic_default_execution_count": 1,
    "repeat_triggers": [
      "random_or_stochastic",
      "concurrency",
      "known_flaky_behavior",
      "unpinned_seed_or_threads",
      "measurement_noise",
      "observed_machine_instability",
      "contradictory_results",
      "user_explicit_request"
    ],
    "file_count_or_path_triggers_assurance": false,
    "independent_review_triggers": [
      "risk_high",
      "release",
      "migration",
      "hard_to_recover_destructive_action",
      "formal_architecture_or_pareto_promotion",
      "external_publication",
      "user_explicit_request"
    ]
  },
  "specialized_assurance": {
    "persistent_longrun": {
      "trigger": "explicit-persistent-or-published-run",
      "status_helper": "scripts/task-run-status.sh",
      "interrupted_or_incomplete_may_pass": false,
      "hash_required_only_for_byte-identity-criteria": true
    },
    "release": {
      "trigger": "explicit-release-publication-or-commercial-delivery",
      "command": "scripts/agent-maintain.sh --mode release",
      "fail_closed": true
    },
    "hash_and_sha": {
      "ordinary_task_identity": false,
      "allowed_criteria": [
        "byte_identity",
        "cache_integrity",
        "release_provenance",
        "supply_chain_or_security",
        "persistence",
        "reproducibility",
        "forensic"
      ]
    }
  },
  "retention": {
    "ordinary_task_run_default": "none",
    "memory_update_required": false,
    "stable_cross_session_facts_only": true,
    "raw_evidence_fulltext_in_db": false,
    "runtime_artifact_contract": ".github/ai-env/contracts/agent-env-runtime-artifacts.json"
  },
  "traceability": {
    "scope": "explicit-release-publication-or-legacy-full-profile",
    "matrix": ".github/ai-env/contracts/agent-env-rebuild-matrix.json",
    "schema_contract": ".github/ai-env/contracts/agent-env-schema-contract.json",
    "observability_contract": ".github/ai-env/contracts/agent-env-observability.json",
    "state_traceability_contract": ".github/ai-env/contracts/agent-env-state-traceability.json",
    "runtime_artifact_contract": ".github/ai-env/contracts/agent-env-runtime-artifacts.json",
    "delivery_contract": ".github/ai-env/contracts/agent-env-delivery.json",
    "review_routing": ".github/ai-env/contracts/agent-env-review-routing.json",
    "branch_health_dashboard": ".github/ai-env/contracts/agent-env-branch-health.json",
    "rtl_task_contract": ".github/ai-env/contracts/agent-env-rtl-task-contract.json",
    "ordinary_task_completion_dependency": false
  },
  "task_delegation": {},
  "task_routing": {
    "cpu_architect": {
      "policy": ".github/ai-env/contracts/cpu-architect-routing-v1.json",
      "classifier": "scripts/cpu_architect_route.py",
      "routing_is_advisory": true,
      "architect_scope": "open-cross-pipeline-or-transaction-lifecycle-tradeoff"
    }
  },
  "state_machine": {
    "instruction": ".github/instructions/agent-env-state-machine.instructions.md",
    "contract": ".github/ai-env/contracts/agent-env-state-traceability.json",
    "ordinary_tasks_require_traceback": false,
    "scope": "legacy-full-profile-or-explicit-publication"
  },
  "observability": {
    "ordinary_task_report_required": false,
    "ordinary_trace_id_required": false,
    "ordinary_run_manifest_required": false,
    "ordinary_profile_resolve_required": false,
    "ordinary_evidence_index_required": false,
    "publication_contract": ".github/ai-env/contracts/agent-env-observability.json"
  },
  "runtime_artifacts": {
    "contract": ".github/ai-env/contracts/agent-env-runtime-artifacts.json",
    "artifact_store_root": ".github/runtime-artifacts",
    "applies_when_payload_is_persisted": true
  },
  "delivery": {
    "contract": ".github/ai-env/contracts/agent-env-delivery.json",
    "delivery_root": "deliverables/ai-dev-env-commercial-v1",
    "package_script": "scripts/package-ai-dev-env.sh",
    "explicit_boundary": true
  },
  "ci": {
    "required_workflow": ".github/workflows/agent-maintain.yml",
    "pull_request_mode": "lightweight-agent-components",
    "release_events": [
      "schedule",
      "workflow_dispatch"
    ],
    "required_commands": [
      "python3 scripts/github_index_db.py rehydrate --backup-dir .github/db-backup/stored-snapshot --yes",
      "python3 scripts/github_index_db.py rehydrate --backup-dir .github/db-backup/task-runs --yes",
      "scripts/agent-maintain.sh --mode final",
      "scripts/agent-maintain.sh --mode release"
    ],
    "nightly_required": true
  }
}
