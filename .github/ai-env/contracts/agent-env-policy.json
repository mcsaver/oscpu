{
  "schema_version": 1,
  "layers": {
    "database": {
      "role": "long-term-memory",
      "db": ".github/cache/github-index.sqlite",
      "backup_roots": [
        ".github/db-backup",
        ".github/db-backup/stored-snapshot",
        ".github/db-backup/task-runs"
      ],
      "raw_evidence_policy": "index-only",
      "artifact_store_roots": [
        ".github/runtime-artifacts",
        ".github/task-runs/*/evidence"
      ]
    },
    "skill": {
      "role": "standardized-processing-rules",
      "live_roots": [
        ".github/skills"
      ],
      "live_rule_kinds": [
        "skill"
      ]
    },
    "agent": {
      "role": "automatic-maintenance-flow",
      "profile": "agent-system",
      "maintainer": "scripts/agent-maintain.sh"
    }
  },
  "agent_tools": {
    "allowed_tools": [
      "agent",
      "edit",
      "execute",
      "read",
      "search",
      "todo"
    ],
    "missing_tools_exemptions": [
      ".github/agents/nemu.agent.md",
      ".github/agents/npc.agent.md"
    ],
    "allow_mcp_servers": false
  },
  "lightweight_workflow": {
    "instruction": ".github/instructions/agent-lightweight-workflow.instructions.md",
    "controller_source": "scripts/agent-flow.c",
    "controller_entry": "scripts/agent-flow.sh",
    "state_root": ".github/runtime-artifacts/agent-flow",
    "task_classes": [
      "review",
      "analysis",
      "docs",
      "development",
      "verification",
      "environment",
      "longrun",
      "cleanup",
      "release"
    ],
    "overhead_target_percent_approx": 40,
    "overhead_target_blocks_delivery": false,
    "gate_frequency": "goal-round-finish-only",
    "changed_path_source": "explicit-agent-flow-log",
    "git_worktree_enumeration": false,
    "read_only_review_runs_guard": false,
    "task_run_modes": [
      "none",
      "compact",
      "durable"
    ],
    "private_token_reasoning_archived": false,
    "structured_engineering_decision_trace": true
  },
  "retention": {
    "db_owned_markdown_must_be_shim": true,
    "task_run_markdown_archive": true,
    "raw_evidence_fulltext_in_db": false,
    "raw_evidence_index_required": true,
    "runtime_artifact_contract": ".github/ai-env/contracts/agent-env-runtime-artifacts.json",
    "runtime_artifact_store_required": true,
    "large_runtime_artifacts_externalized": true,
    "waveform_artifacts_externalized": true
  },
  "traceability": {
    "matrix": ".github/ai-env/contracts/agent-env-rebuild-matrix.json",
    "schema_contract": ".github/ai-env/contracts/agent-env-schema-contract.json",
    "observability_contract": ".github/ai-env/contracts/agent-env-observability.json",
    "state_traceability_contract": ".github/ai-env/contracts/agent-env-state-traceability.json",
    "runtime_artifact_contract": ".github/ai-env/contracts/agent-env-runtime-artifacts.json",
    "delivery_contract": ".github/ai-env/contracts/agent-env-delivery.json",
    "review_routing": ".github/ai-env/contracts/agent-env-review-routing.json",
    "branch_health_dashboard": ".github/ai-env/contracts/agent-env-branch-health.json",
    "rtl_task_contract": ".github/ai-env/contracts/agent-env-rtl-task-contract.json",
    "source_report": "user-supplied:deep-research-report.md",
    "required_ids": [
      "R1",
      "R2",
      "R3",
      "R4",
      "R5",
      "R6",
      "R7",
      "R8",
      "R9"
    ]
  },
  "task_delegation": {
    "contract": ".github/ai-env/contracts/agent-env-rtl-task-contract.json",
    "instruction": ".github/instructions/rtl-agent-task-contract.instructions.md",
    "skill": ".github/skills/prepare-rtl-task-contract/SKILL.md",
    "generator": ".github/skills/prepare-rtl-task-contract/scripts/rtl_task_contract.py",
    "profile_node": "rtl-task-contract",
    "local_rtl_material_source": "declared-workspace-paths",
    "contract_before_dispatch_required": true,
    "hardware_wording_profile_required": true,
    "positive_local_scope_preamble_required": true,
    "ambiguous_terms_require_hardware_context": true,
    "final_response_hardware_evidence_first_required": true,
    "rendered_prompt_platform_meta_forbidden": true,
    "rendered_prompt_coordination_meta_forbidden": true,
    "rendered_prompt_style": "compact-rv64-hardware-evidence",
    "technical_narrative_subject": "local-rv64-rtl-object-or-evidence",
    "subagent_context_mode": "rendered-contract-only",
    "full_history_inheritance_forbidden": true,
    "wording_profile_changes_capabilities": false,
    "wording_keyword_blacklist_forbidden": true
  },
  "state_machine": {
    "instruction": ".github/instructions/agent-env-state-machine.instructions.md",
    "contract": ".github/ai-env/contracts/agent-env-state-traceability.json",
    "audit_command": "python3 scripts/github_index_db.py state-audit",
    "states": [
      "recall_context",
      "classify_layer",
      "plan_graph",
      "implement",
      "verify",
      "inspect",
      "persist"
    ],
    "inspector": "agent-system",
    "coordinator": "ysyx-coordinator",
    "traceback_required": true,
    "adversarial_personas_required": true,
    "conflict_resolution_required": true,
    "reviewer_profile_nodes": [
      "state-machine-traceback",
      "reviewer-inspector-gate"
    ]
  },
  "observability": {
    "task_run_report_required": false,
    "task_run_policy": "class-dependent-none-compact-durable",
    "trace_id_required": true,
    "run_manifest_required": true,
    "observability_contract": ".github/ai-env/contracts/agent-env-observability.json",
    "profile_resolve_required": true,
    "evidence_index_required": true,
    "memory_update_required": false,
    "branch_health_report_required": false
  },
  "branch_health": {
    "dashboard": ".github/ai-env/contracts/agent-env-branch-health.json",
    "review_routing": ".github/ai-env/contracts/agent-env-review-routing.json",
    "report_command": "python3 scripts/github_index_db.py branch-health-report",
    "audit_command": "python3 scripts/github_index_db.py branch-health-audit"
  },
  "runtime_artifacts": {
    "contract": ".github/ai-env/contracts/agent-env-runtime-artifacts.json",
    "audit_command": "python3 scripts/github_index_db.py artifact-audit",
    "profile_nodes": [
      "runtime-artifact-boundary"
    ],
    "raw_evidence_policy": "index-only",
    "artifact_store_root": ".github/runtime-artifacts"
  },
  "delivery": {
    "contract": ".github/ai-env/contracts/agent-env-delivery.json",
    "audit_command": "python3 scripts/github_index_db.py delivery-audit",
    "delivery_root": "deliverables/ai-dev-env-commercial-v1",
    "archive_root": ".github/archive/legacy-ai-dev-env-2026-06-13",
    "package_script": "scripts/package-ai-dev-env.sh"
  },
  "ci": {
    "required_workflow": ".github/workflows/agent-maintain.yml",
    "required_commands": [
      "python3 scripts/github_index_db.py rehydrate --backup-dir .github/db-backup/stored-snapshot --yes",
      "python3 scripts/github_index_db.py rehydrate --backup-dir .github/db-backup/task-runs --yes",
      "scripts/agent-maintain.sh --mode final",
      "scripts/agent-maintain.sh --mode release"
    ],
    "nightly_required": true
  }
}
