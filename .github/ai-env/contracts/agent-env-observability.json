{
  "schema_version": 1,
  "purpose": "Unified trace and run-manifest contract for agent -> e2e -> database observability.",
  "trace_id_format": "e2e:<run_id>",
  "run_manifest_path": ".github/task-runs/<run_id>/run-manifest.json",
  "generated_by": "scripts/e2e/lib/report.sh",
  "audit_command": "python3 scripts/github_index_db.py trace-audit",
  "required_manifest_fields": [
    "trace_id",
    "run_id",
    "task_slug",
    "profile",
    "status",
    "git",
    "artifacts",
    "node_counts",
    "evidence"
  ],
  "artifact_links": [
    "task_report",
    "dispatch_log",
    "context_brief",
    "profile_resolve",
    "evidence_index",
    "nodes",
    "run_manifest"
  ],
  "database_mapping": {
    "task_run_markdown": "db_documents",
    "raw_evidence_table": "evidence_assets",
    "runtime_artifact_contract": ".github/ai-env/contracts/agent-env-runtime-artifacts.json",
    "runtime_artifact_store": ".github/runtime-artifacts",
    "run_manifest_index": "run-manifest.json is indexed as a json evidence asset",
    "access_telemetry": "access_log"
  },
  "dashboard_queries": [
    "python3 scripts/github_index_db.py runs --profile agent-system --limit 5",
    "python3 scripts/github_index_db.py evidence --run-id <run_id>",
    "python3 scripts/github_index_db.py usage --limit 10",
    "python3 scripts/github_index_db.py trace-audit --run-id <run_id>",
    "python3 scripts/github_index_db.py artifact-audit --run-id <run_id>"
  ]
}
