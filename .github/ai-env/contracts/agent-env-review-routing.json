{
  "schema_version": 1,
  "scope": "explicit-release-publication-or-requested-review",
  "ordinary_path_checks_are_advisory": true,
  "purpose": "Risk-triggered agent review routing for the three-layer AI development environment.",
  "review_routes": [
    {
      "id": "database-layer",
      "layer": "database",
      "primary_agent": "agent-system",
      "paths": [
        ".github/ai-env/contracts/agent-env-schema-contract.json",
        ".github/memory",
        ".github/task-runs",
        "scripts/dev_memory",
        "scripts/github_index_db.py"
      ],
      "required_checks": [
        "schema-audit",
        "audit-db-first",
        "audit-markdown-coverage",
        "branch-health-audit"
      ]
    },
    {
      "id": "skill-layer",
      "layer": "skill",
      "primary_agent": "agent-system",
      "paths": [
        "AGENTS.md",
        ".github/AGENTS.md",
        ".github/instructions",
        ".github/skills"
      ],
      "required_checks": [
        "skill-audit",
        "report-audit",
        "branch-health-audit"
      ]
    },
    {
      "id": "agent-layer",
      "layer": "agent",
      "primary_agent": "ysyx-coordinator",
      "inspector": "agent-system",
      "paths": [
        ".codex/agents",
        ".github/agents",
        ".github/e2e",
        ".github/workflows",
        ".github/ai-env/contracts/agent-env-policy.json",
        ".github/ai-env/contracts/agent-env-rebuild-matrix.json",
        ".github/ai-env/contracts/agent-env-state-traceability.json",
        ".github/ai-env/contracts/agent-env-branch-health.json",
        ".github/ai-env/contracts/agent-env-review-routing.json",
        ".github/ai-env/contracts/cpu-architect-routing-v1.json",
        ".github/ai-env/contracts/cpu-architect-learning-v1.json",
        "scripts/agent-e2e.sh",
        "scripts/agent-maintain.sh",
        "scripts/cpu_architect_route.py",
        "scripts/cpu_architect_learning.py",
        "scripts/e2e"
      ],
      "required_checks": [
        "policy-audit",
        "report-audit",
        "branch-health-report",
        "branch-health-audit"
      ]
    }
  ],
  "adversarial_personas": {
    "activation": "risk-triggered",
    "default_required": false,
    "triggers": [
      "risk_high",
      "release",
      "migration",
      "hard_to_recover_destructive_action",
      "formal_architecture_or_pareto_promotion",
      "external_publication",
      "user_explicit_request"
    ],
    "non_triggers": [
      "workspace_write_by_itself",
      "cross_file_change_by_itself",
      "long_runtime_by_itself",
      "non_trivial_label",
      "file_count"
    ],
    "implementer_persona": {
      "role": "deliver",
      "must_provide": [
        "change_summary",
        "verification_evidence",
        "delivery_boundary"
      ]
    },
    "reviewer_persona": {
      "role": "refute",
      "must_challenge": [
        "counterexample",
        "coverage_gap",
        "false_green",
        "missing_profile",
        "missing_context",
        "overclaim"
      ]
    },
    "conflict_resolution_required": true,
    "unresolved_conflict_policy": "deliver_subtask_status_with_remaining_risk"
  },
  "requirement_routes": {
    "R1": "skill-layer",
    "R2": "agent-layer",
    "R3": "database-layer",
    "R4": "database-layer",
    "R5": "agent-layer",
    "R6": "database-layer",
    "R7": "agent-layer",
    "R8": "skill-layer",
    "R9": "agent-layer"
  },
  "review_rules": [
    "When this contract is explicitly selected for requested review, release or publication, a cross-layer change identifies at least one relevant review route.",
    "Implementer/reviewer opposition is required only when a declared risk trigger is present; ordinary deterministic delivery uses implementer self-critique and direct finish.",
    "An independent reviewer challenges identity, counterexamples, coverage and claim boundaries without mechanically rerunning an already bound deterministic command.",
    "When independent review is triggered, unresolved implementer/reviewer conflicts must be reported as remaining risk or next action, not hidden behind a completed claim.",
    "Database-layer changes must keep stored ownership limited to retained memory/log documents and preserve backup/snapshot consistency.",
    "Skill-layer changes must keep SKILL.md live and under audit.",
    "If an explicitly requested agent-layer review is persisted, retain only the evidence needed to support its scoped conclusion."
  ]
}
