{
  "schema_version": 1,
  "purpose": "Agent review routing for the three-layer AI development environment.",
  "review_routes": [
    {
      "id": "database-layer",
      "layer": "database",
      "primary_agent": "agent-system",
      "paths": [
        ".github/ai-env/contracts/agent-env-schema-contract.json",
        ".github/memory",
        ".github/task-runs",
        "scripts/dev_memory",
        "scripts/github_index_db.py"
      ],
      "required_checks": [
        "schema-audit",
        "audit-db-first",
        "audit-markdown-coverage",
        "branch-health-audit"
      ]
    },
    {
      "id": "skill-layer",
      "layer": "skill",
      "primary_agent": "agent-system",
      "paths": [
        "AGENTS.md",
        ".github/AGENTS.md",
        ".github/instructions",
        ".github/skills"
      ],
      "required_checks": [
        "skill-audit",
        "report-audit",
        "branch-health-audit"
      ]
    },
    {
      "id": "agent-layer",
      "layer": "agent",
      "primary_agent": "ysyx-coordinator",
      "inspector": "agent-system",
      "paths": [
        ".github/agents",
        ".github/e2e",
        ".github/workflows",
        ".github/ai-env/contracts/agent-env-policy.json",
        ".github/ai-env/contracts/agent-env-rebuild-matrix.json",
        ".github/ai-env/contracts/agent-env-state-traceability.json",
        ".github/ai-env/contracts/agent-env-branch-health.json",
        ".github/ai-env/contracts/agent-env-review-routing.json",
        "scripts/agent-e2e.sh",
        "scripts/agent-maintain.sh",
        "scripts/e2e"
      ],
      "required_checks": [
        "policy-audit",
        "report-audit",
        "state-audit",
        "branch-health-report",
        "branch-health-audit"
      ]
    }
  ],
  "adversarial_personas": {
    "implementer_persona": {
      "role": "deliver",
      "must_provide": [
        "change_summary",
        "verification_evidence",
        "delivery_boundary"
      ]
    },
    "reviewer_persona": {
      "role": "refute",
      "must_challenge": [
        "counterexample",
        "coverage_gap",
        "false_green",
        "missing_profile",
        "missing_context",
        "overclaim"
      ]
    },
    "conflict_resolution_required": true,
    "unresolved_conflict_policy": "deliver_subtask_status_with_remaining_risk"
  },
  "requirement_routes": {
    "R1": "skill-layer",
    "R2": "agent-layer",
    "R3": "database-layer",
    "R4": "database-layer",
    "R5": "agent-layer",
    "R6": "database-layer",
    "R7": "agent-layer",
    "R8": "skill-layer",
    "R9": "agent-layer"
  },
  "review_rules": [
    "Every cross-layer change must identify at least one review route before final reporting.",
    "Every non-trivial delivery must run implementer_persona and reviewer_persona in opposition before final reporting.",
    "Unresolved implementer/reviewer conflicts must be reported as remaining risk or next action, not hidden behind a completed claim.",
    "Database-layer changes must keep stored ownership limited to retained memory/log documents and preserve backup/snapshot consistency.",
    "Skill-layer changes must keep SKILL.md live and under audit.",
    "Agent-layer changes must leave task-run evidence when profile or workflow behavior changes."
  ]
}
