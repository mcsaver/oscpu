{
  "schema_version": 1,
  "database": {
    "path": ".github/cache/github-index.sqlite",
    "runtime_schema_version": "4",
    "owner_layer": "database",
    "description": "SQLite development memory/index for active .github sources, retained memory/log stored documents, e2e task-runs, evidence assets, and access logs."
  },
  "entities": [
    {
      "name": "agent_profiles",
      "layer": "agent",
      "backing_tables": ["files", "file_text", "file_chunks"],
      "path_kinds": ["agent", "agent-rule", "agent-shim"],
      "identity": "path"
    },
    {
      "name": "skills",
      "layer": "skill",
      "backing_tables": ["files", "file_text"],
      "path_kinds": ["skill"],
      "identity": "path"
    },
    {
      "name": "instructions",
      "layer": "skill",
      "backing_tables": ["files", "file_text", "file_chunks"],
      "path_kinds": ["instruction"],
      "identity": "path"
    },
    {
      "name": "memory_documents",
      "layer": "database",
      "backing_tables": ["db_documents", "db_document_chunks"],
      "path_kinds": ["memory", "memory-module"],
      "identity": "path"
    },
    {
      "name": "e2e_profiles",
      "layer": "agent",
      "backing_tables": ["files", "file_text", "file_chunks"],
      "path_kinds": ["e2e-profile", "e2e-module"],
      "identity": "path"
    },
    {
      "name": "task_runs",
      "layer": "database",
      "backing_tables": ["db_documents", "db_document_chunks", "evidence_assets"],
      "path_kinds": ["task-report", "dispatch-log", "task-run", "task-evidence"],
      "identity": "run_id"
    },
    {
      "name": "runtime_artifacts",
      "layer": "database",
      "backing_tables": ["evidence_assets"],
      "path_kinds": ["task-evidence", "artifact-pointer"],
      "identity": "path"
    },
    {
      "name": "access_events",
      "layer": "database",
      "backing_tables": ["access_log", "events"],
      "path_kinds": [],
      "identity": "id"
    }
  ],
  "tables": {
    "meta": ["key", "value"],
    "files": [
      "path", "kind", "size_bytes", "mtime_ns", "sha256", "line_count",
      "title", "description", "declared_status", "tags", "exists_flag",
      "index_status", "indexed_at", "updated_at"
    ],
    "file_text": ["path", "content"],
    "file_chunks": [
      "chunk_id", "path", "ordinal", "heading", "start_line", "end_line",
      "token_estimate", "summary", "text"
    ],
    "db_documents": [
      "path", "kind", "title", "description", "tags", "sha256",
      "line_count", "content", "source_indexed_at", "stored_at"
    ],
    "db_document_chunks": [
      "chunk_id", "path", "ordinal", "heading", "start_line", "end_line",
      "token_estimate", "summary", "text"
    ],
    "events": ["id", "ts", "action", "details"],
    "access_log": [
      "id", "used_at", "surface", "op", "source", "target", "ok",
      "result_count", "details"
    ],
    "evidence_assets": [
      "path", "run_id", "task_slug", "profile", "kind", "size_bytes",
      "mtime_ns", "sha256", "line_count", "encoding", "summary",
      "head_excerpt", "tail_excerpt", "markers", "indexed_at"
    ]
  },
  "optional_virtual_tables": {
    "file_fts": ["path", "title", "description", "tags", "content"],
    "chunk_fts": ["chunk_id", "path", "heading", "summary", "text"],
    "document_fts": ["chunk_id", "path", "heading", "summary", "text"]
  },
  "api": {
    "protocol": "github-index-jsonl-v1",
    "surface": "scripts/github_index_db.py api",
    "mode": "read-only",
    "required_operations": [
      "schema",
      "stat",
      "search",
      "summary",
      "load",
      "show",
      "brief",
      "profiles",
      "resolve-profile",
      "runs",
      "evidence",
      "usage"
    ]
  },
  "retention": {
    "db_owned_markdown_must_be_shim": false,
    "db_owned_kinds": ["memory", "memory-module", "task-report", "dispatch-log", "task-run", "task-evidence"],
    "non_memory_log_documents_live_first": true,
    "task_run_markdown_archive": true,
    "raw_evidence_fulltext_in_db": false,
    "raw_evidence_index_required": true,
    "runtime_artifact_contract": ".github/ai-env/contracts/agent-env-runtime-artifacts.json",
    "raw_evidence_index_table": "evidence_assets",
    "large_runtime_artifacts_externalized": true,
    "waveform_artifacts_externalized": true
  },
  "audit": {
    "command": "python3 scripts/github_index_db.py schema-audit",
    "required_in_maintenance_gate": true
  }
}
