        "objectives": ["correctness", "timing", "cpi", "area"],
        "baseline_ready": true,
        "evidence_paths_ready": true,
        "candidate_exists": false,
        "architecture_change_authorized": true,
        "risk": "medium",
        "determinism": "deterministic",
        "known_machine_instability": false,
        "repeat_requested": false
      },
      "expected": {"route": "ARCHITECT", "execution": "SINGLE_PASS", "review": "SELF_CRITIC"}
