{
  "schema_version": 1,
  "router_id": "cpu-architect-semantic-router-v1",
  "purpose": "Optional semantic routing decision support for the project CPU Architect Agent; this policy does not grant or deny work authority.",
  "instruction": ".github/instructions/cpu-architect-routing.instructions.md",
  "custom_agent": ".codex/agents/cpu-architect.toml",
  "canonical_agent": ".github/agents/cpu-architect.agent.md",
  "classifier": "scripts/cpu_architect_route.py",
  "authority_model": {
    "role_selection_source": "task_semantics_and_delegated_ownership",
    "classifier_mode": "optional_advisory",
    "classifier_receipt_required": false,
    "classifier_can_authorize_work": false,
    "classifier_can_block_in_scope_safe_local_work": false,
    "architecture_change_scope_source": "user_or_parent_task"
  },
  "scopes": {
    "ordinary_architecture_task": {
      "default": true,
      "fixed_startup_yaml_required": false,
      "architecture_ir_required_per_experiment": false,
      "content_manifest_required_per_experiment": false,
      "grounded_learning_loop_required": false,
      "fixed_final_report_schema_required": false,
      "minimum_outcome": [
        "bounded_structural_change",
        "preserved_correctness_invariants",
        "correctness_plus_one_measurable_metric",
        "comparable_baseline_candidate_evidence",
        "falsifier_and_rollback",
        "pass_gap_boundary"
      ]
    },
    "formal_architecture_or_pareto_promotion": {
      "explicit_boundary": true,
      "independent_review_required": true,
      "identity_and_provenance_required": [
        "baseline_and_candidate_source_revision_or_source_set",
        "production_filelist_and_elaboration",
        "design_and_configuration",
        "workload",
        "tool_and_version",
        "corner_clock_and_constraints",
        "raw_wave_counter_or_eda_artifact_as_applicable"
      ]
    },
    "formal_research_or_learning": {
      "opt_in_only": true,
      "activation": "explicit_user_or_task_acceptance_criterion",
      "may_use": [
        "Grounded Experience Loop",
        "CapabilityGraph",
        "ExperienceRecord",
        "Meta-Critic",
        "KnowledgeGap",
        "prediction calibration",
        "unseen exam"
      ],
      "cannot_gate_ordinary_architecture_work": true
    }
  },
  "grounded_learning_policy": ".github/ai-env/contracts/cpu-architect-learning-v1.json",
  "grounded_learning_policy_scope": "formal_research_or_learning_opt_in",
  "required_fields": [
    "domain",
    "intent",
    "design_choice",
    "root_cause",
    "semantic_depth",
    "objectives",
    "baseline_ready",
    "evidence_paths_ready",
    "candidate_exists",
    "architecture_change_authorized",
    "risk",
    "determinism",
    "known_machine_instability",
    "repeat_requested"
  ],
  "enums": {
    "domain": ["local_rv64_cpu", "cpu_adjacent", "tooling", "generic"],
    "intent": ["redesign", "trade_study", "diagnose", "implement_fixed", "verify", "report"],
    "design_choice": ["open", "fixed", "unknown"],
    "root_cause": ["causal_chain_known", "localized", "unknown"],
    "semantic_depth": ["mechanical", "local_logic", "cross_module_protocol", "architectural_state"],
    "objective": ["correctness", "cpi", "timing", "area", "power", "complexity"],
    "risk": ["low", "medium", "high", "migration", "release"],
    "determinism": ["deterministic", "concurrent", "flaky", "variable_ppa", "stochastic", "unknown"]
  },
  "routes": ["ARCHITECT", "EXPLORER", "WORKER", "REVIEWER", "CLARIFY", "NON_ARCH"],
  "architect_hard_gates": {
    "compatibility_semantics": "Legacy classifier field name: these are advisory semantic signals, not agent permission gates.",
    "domain": "local_rv64_cpu",
    "intents": ["redesign", "trade_study"],
    "design_choice": "open",
    "semantic_depth": ["cross_module_protocol", "architectural_state"],
    "root_cause": ["causal_chain_known", "localized"],
    "required_objective": "correctness",
    "required_tradeoff_objectives": ["cpi", "timing", "area", "power", "complexity"],
    "baseline_ready": true,
    "evidence_paths_ready": true,
    "architecture_change_authorized": true
  },
  "verification_policy": {
    "default_execution_count": 1,
    "single_pass_determinism": ["deterministic"],
    "repeat_determinism": ["concurrent", "flaky", "variable_ppa", "stochastic"],
    "repeat_requires_reason_threshold_and_stop_condition": true,
    "independent_review_risks": ["high", "migration", "release"],
    "distinct_evidence_is_not_repetition": [
      "baseline_vs_candidate",
      "positive_vs_negative_oracle",
      "different_config_or_corner",
      "different_mutation",
      "different_abstraction_layer"
    ]
  },
  "workspace_search_dimensions": [
    "frontend_fetch_predict_redirect",
    "decode_rename_allocate",
    "scheduling_issue_wakeup",
    "regread_bypass_execution",
    "memory_lsq_cache_mmu_axi",
    "writeback_rob_precise_commit",
    "csr_trap_fence_serialization",
    "cpi_timing_area_power_system_evidence"
  ],
  "examples": [
