{
  "schema_version": 1,
  "scope": "legacy-full-profile-or-explicit-publication",
  "ordinary_task_required": false,
  "active_default": false,
  "purpose": "Compatibility schema for previously published state_traceback payloads. It does not prescribe the sequence, permission state, reviewer, inspector, or persistence behavior of ordinary tasks.",
  "state_machine_doc": ".github/instructions/agent-env-state-machine.instructions.md",
  "profile": ".github/e2e/profiles/agent-system.tsv",
  "audit_command": "python3 scripts/github_index_db.py state-audit",
  "required_states": [
    "recall_context",
    "classify_layer",
    "plan_graph",
    "implement",
    "verify",
    "inspect",
    "persist"
  ],
  "required_traceback_fields": [
    "state_sequence",
    "current_state",
    "failure_state",
    "rollback_target",
    "failure_reason",
    "reviewer",
    "inspector",
    "evidence_policy"
  ],
  "reviewer_inspector_nodes": [
    {
      "node_id": "state-machine-traceback",
      "function": "e2e_agent_system_state_traceback",
      "owner_agent": "agent-system",
      "module": "agent-system",
      "checks": [
        "state_traceback in task-report.md",
        "state_traceback in run-manifest.json",
        "state-audit"
      ]
    },
    {
      "node_id": "reviewer-inspector-gate",
      "function": "e2e_agent_system_reviewer_inspector_gate",
      "owner_agent": "agent-system",
      "module": "agent-system",
      "checks": [
        "review routing maps R7 to agent-layer",
        "agent-layer has ysyx-coordinator reviewer and agent-system inspector",
        "implementer/reviewer adversarial personas are activated only by declared risk triggers",
        "ordinary deterministic delivery permits implementer self-critique and direct finish",
        "triggered unresolved conflicts are reported as remaining risk",
        "agent-system profile executes the reviewer/inspector gate"
      ]
    }
  ],
  "rollback_rules": [
    {
      "from_state": "verify",
      "to_state": "implement",
      "evidence_field": "failure_reason"
    },
    {
      "from_state": "inspect",
      "to_state": "plan_graph",
      "evidence_field": "rollback_target"
    },
    {
      "from_state": "persist",
      "to_state": "implement",
      "evidence_field": "failure_state"
    }
  ],
  "legacy_compatibility_check": {
    "explicit_command_only": true,
    "historical_run_manifest_field": "state_traceback",
    "ordinary_completion_dependency": false
  }
}
