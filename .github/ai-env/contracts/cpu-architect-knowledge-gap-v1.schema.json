{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ysyx.local/schemas/cpu-architect-knowledge-gap-v1.schema.json",
  "title": "CPU Architect KnowledgeGap v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "gap_id", "source_experience_ids", "trigger", "error_class",
    "failed_prediction", "missing_information", "falsifiable_question", "capability_ids",
    "acquisition_plan", "validation_plan", "priority", "status", "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "gap_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "source_experience_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "trigger": {"enum": ["failure", "uncertainty", "calibration", "tool_error", "counterexample"]},
    "error_class": {"enum": ["E1", "E2", "E3", "E4", "E5", "E6", "E7", "E8", "E9", "E10"]},
    "failed_prediction": {"type": "string", "minLength": 1},
    "missing_information": {"type": "string", "minLength": 1},
    "falsifiable_question": {"type": "string", "minLength": 1},
    "capability_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "acquisition_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "action", "source_refs"],
      "properties": {
        "level": {"enum": ["context_acquisition", "knowledge_memory", "strategy_memory", "training_candidate"]},
        "action": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "validation_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cheapest_discriminating_experiment", "expected_uncertainty_reduction", "experiment_cost", "voi", "success_criterion", "counterexample"],
      "properties": {
        "cheapest_discriminating_experiment": {"type": "string", "minLength": 1},
        "expected_uncertainty_reduction": {"type": "number", "minimum": 0},
        "experiment_cost": {"type": "number", "exclusiveMinimum": 0},
        "voi": {"type": "number", "minimum": 0},
        "success_criterion": {"type": "string", "minLength": 1},
        "counterexample": {"type": "string", "minLength": 1}
      }
    },
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["impact", "frequency", "uncertainty", "learning_cost", "score"],
      "properties": {
        "impact": {"type": "number", "minimum": 0},
        "frequency": {"type": "number", "minimum": 0},
        "uncertainty": {"type": "number", "minimum": 0},
        "learning_cost": {"type": "number", "exclusiveMinimum": 0},
        "score": {"type": "number", "minimum": 0}
      }
    },
    "status": {"enum": ["open", "learning", "exam_pending", "validated", "rejected"]},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
