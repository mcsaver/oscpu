{
  "schema_version": 1,
  "scope": "explicit-release-publication-or-requested-dashboard",
  "ordinary_task_completion_dependency": false,
  "purpose": "Branch health dashboard contract for explicit release/publication or a requested repository-health report; it is not an ordinary task completion gate.",
  "review_routing": ".github/ai-env/contracts/agent-env-review-routing.json",
  "report_command": "python3 scripts/github_index_db.py branch-health-report",
  "audit_command": "python3 scripts/github_index_db.py branch-health-audit",
  "required_signals": [
    "current_branch",
    "head_commit",
    "upstream",
    "git_status_counts",
    "review_routes",
    "matrix_status",
    "maintenance_gates"
  ],
  "maintenance_gates": [
    "report-audit",
    "schema-audit",
    "artifact-audit",
    "delivery-audit",
    "policy-audit",
    "skill-audit",
    "branch-health-report",
    "branch-health-audit",
    "audit-db-first",
    "audit-markdown-coverage",
    "validate-all-profiles"
  ],
  "status_policy": {
    "clean_required_for_completion_claim": false,
    "clean_required_for_release_or_publication_claim": true,
    "dirty_worktree_allowed_during_codex_iteration": true,
    "untracked_persistent_agent_sources_fail_agent_system_profile": true
  }
}
