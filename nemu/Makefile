# Capture the top-level Makefile location now.  A recursive `?=` expression
# would re-evaluate `lastword(MAKEFILE_LIST)` after filelist.mk inclusions and
# could silently turn NEMU_HOME into a source subdirectory.
ifeq ($(origin NEMU_HOME), undefined)
NEMU_HOME := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
endif

##作用：检查$(NEMU_HOME)/src/nemu-main.c是否存在，如果不存在，报错并终止构建，防止在错误目录下进行操作
##wildcard :是GNU Make的一个内置函数，用于通配符匹配文件名，即在Makefile中查找符合某种模式的文件，并且返回他们的列表
##wildcard会检查$(NEMU_HOME)/src/nemu-main.c是否存在
# Sanity check
ifeq ($(wildcard $(NEMU_HOME)/src/nemu-main.c),)
  $(error NEMU_HOME=$(NEMU_HOME) is not a NEMU repo)
endif

# Kconfig 输出默认仍位于源码树；上层可为不同 NEMU profile 指定独立目录，
# 从而同时保留 headless 与 GUI 的 .config、auto.conf 和 autoconf.h。
NEMU_CONFIG_DIR ?= $(NEMU_HOME)
NEMU_CONFIG_DIR := $(abspath $(NEMU_CONFIG_DIR))
NEMU_HOME_REAL := $(shell realpath -m -- '$(NEMU_HOME)')
NEMU_CONFIG_DIR_REAL := $(shell realpath -m -- '$(NEMU_CONFIG_DIR)')
ifneq ($(NEMU_CONFIG_DIR),$(NEMU_HOME))
  ifeq ($(filter $(NEMU_HOME)/build/%,$(NEMU_CONFIG_DIR)),)
    $(error unsafe NEMU_CONFIG_DIR=$(NEMU_CONFIG_DIR); use NEMU_HOME itself or a strict child of $(NEMU_HOME)/build)
  endif
  ifeq ($(filter $(NEMU_HOME_REAL)/build/%,$(NEMU_CONFIG_DIR_REAL)),)
    $(error NEMU_CONFIG_DIR=$(NEMU_CONFIG_DIR) escapes $(NEMU_HOME_REAL)/build after symlink resolution)
  endif
endif
NEMU_DOT_CONFIG := $(NEMU_CONFIG_DIR)/.config
NEMU_AUTOCONFIG := $(NEMU_CONFIG_DIR)/include/config/auto.conf
NEMU_AUTOCONFIG_DEP := $(NEMU_CONFIG_DIR)/include/config/auto.conf.cmd
NEMU_AUTOHEADER := $(NEMU_CONFIG_DIR)/include/generated/autoconf.h
NEMU_SPLITCONFIG := $(NEMU_CONFIG_DIR)/include/config/
BUILD_DIR = $(CURDIR)/build
override KCONFIG_CONFIG := $(NEMU_DOT_CONFIG)
override KCONFIG_AUTOCONFIG := $(NEMU_AUTOCONFIG)
override KCONFIG_AUTOCONFIG_DEP := $(NEMU_AUTOCONFIG_DEP)
override KCONFIG_AUTOHEADER := $(NEMU_AUTOHEADER)
override KCONFIG_SPLITCONFIG := $(NEMU_SPLITCONFIG)
export KCONFIG_CONFIG KCONFIG_AUTOCONFIG KCONFIG_AUTOCONFIG_DEP
export KCONFIG_AUTOHEADER KCONFIG_SPLITCONFIG

##在Makefile中,include文件名的作用是把指定文件的内容在当前位置原样插入，就像把那部分代码粘贴进来一样
##不是执行shell脚本，而是让Make读取并解析被包含文件中的变量定义、规则、命令等等
# Include variables and rules generated by menuconfig
-include $(NEMU_AUTOCONFIG)
-include $(NEMU_AUTOCONFIG_DEP)

# The outer make parses generated configuration before it can acquire the
# writer lock.  Remember the exact parse snapshot and make the lock-holding
# recursive make reject a stale outer graph.  Without this check, a concurrent
# defconfig could change NAME/backend while the outer make waits; an existing
# binary from the old graph could then make the recursive build return success
# without producing the newly selected configuration.
NEMU_CONFIG_PARSE_ID := $(shell sha256sum \
  '$(NEMU_DOT_CONFIG)' '$(NEMU_AUTOCONFIG)' '$(NEMU_AUTOCONFIG_DEP)' \
  '$(NEMU_AUTOHEADER)' 2>/dev/null | sha256sum | cut -d' ' -f1)
ifeq ($(strip $(NEMU_CONFIG_PARSE_ID)),)
  $(error failed to compute NEMU generated configuration identity)
endif
ifeq ($(NEMU_BUILD_LOCK_HELD),1)
ifneq ($(strip $(NEMU_OUTER_CONFIG_PARSE_ID)),)
ifneq ($(NEMU_OUTER_CONFIG_PARSE_ID),$(NEMU_CONFIG_PARSE_ID))
  $(error NEMU configuration changed before the build transaction acquired its locks; retry the command)
endif
endif
endif

# Both native and Abstract-Machine targets need a transaction lock before
# config.mk is included, otherwise AM distclean would see an empty lock path.
# Select the backend only after auto.conf has supplied CONFIG_TARGET_AM.  AM
# ignores BUILD_DIR and redirects its complete output graph with AM_BUILD_ROOT.
ifeq ($(CONFIG_TARGET_AM),y)
NEMU_BUILD_LOCK_ROOT := $(if $(strip $(AM_BUILD_ROOT)),$(abspath $(AM_BUILD_ROOT)),$(CURDIR)/build)
else
NEMU_BUILD_LOCK_ROOT := $(BUILD_DIR)
endif
NEMU_BUILD_LOCK := $(shell realpath -m -- '$(NEMU_BUILD_LOCK_ROOT)').lock

##patsubst是GNU MAKE的一个字符串模式替换函数
##基本用法$(patsubst <模式>,<替换>,<文本>)
##<模式>：要匹配的字符串模式(可以用%作为通配符)
##<替换>：匹配后要替换成的内容(%代表原来匹配的部分)
##<文本>：要处理的字符串(可以是变量)
##此处的意思是把参数$(1)中的所有的中英文引号都替换成空
remove_quote = $(patsubst "%",%,$(1))

##在Makefile中，自定义宏（函数）的调用和C语言不同
##Makefile使用$(call 宏名，参数1， 参数2，...)的形式来调用自定义宏
##CONFIG_ISA="riscv32"，执行引擎固定为 interpreter
##NAME=riscv32-nemu-interpreter
# Extract variabls from menuconfig
GUEST_ISA ?= $(call remove_quote,$(CONFIG_ISA))
# NEMU 只有 interpreter 这一种执行引擎；不允许环境或命令行把
# 产物改名成一个实际不存在的其他 engine，否则 Linux 入口可能继续
# 运行 build/riscv64-nemu-interpreter 中的旧二进制。
override ENGINE := interpreter
NAME    = $(GUEST_ISA)-nemu-$(ENGINE)

##$(shell ...)这是makefile的内置函数，用于执行括号内的shell命令，并把输出结果作为字符串返回
##find -L ./src -name "filelist.mk"这是一个shell命令，意思是递归查找src目录下所有名为filelist.mk的文件
##-L选项表示跟随符号连接：如果目录或者文件是符号链接，也会进入连接指向的目录继续查找
##FILELIST_MK= ...把上面命令的输出(即所有找到的filelist.mk文件的路径，空格分隔)赋值给变量FILELIST_MK
# Include all filelist.mk to merge file lists
FILELIST_MK = $(shell find -L ./src -name "filelist.mk")
include $(FILELIST_MK)

##DIRS-BLACKLIST-y += $(DIRS-BLACKLIST)把变量DIRS-BLACKLIST的内容追加到DIRS-BLACKLIST-y
##背景：DIRS-BLACKLIST里通常存放需要排除(不参与编译)的目录列表，DIRS-BLACKLIST-y是最终用于处理的黑名单目录变量
##下面一句的作用是把SRCS-BLACKLIST变量中的文件和所有黑名单目录下的.c文件都追加到SRCS-BLACKLIST-y
##结果SRCS-BLACKLIST-y现在包含了所有需要排除的C源文件
##SRCS-y += ..：递归查找所有白名单目录(DIRS-y)下的.c文件，并追加到SRCS-y中
##结果就是SRCS-y包含了所有候选的C源文件
##SRCS = $(....)...：从所有候选源文件SRCS-y中，过滤掉黑名单中的源文件SRCS-BLACKLIST-y，得到最终要编译的源文件列表SRCS
##filter-out是MAKE的内置函数，用于从一个列表中过滤掉指定内容，结果就是SRCS就是最终参与编译的所有C源文件
# Filter out directories and files in blacklist to obtain the final set of source files
DIRS-BLACKLIST-y += $(DIRS-BLACKLIST)
SRCS-BLACKLIST-y += $(SRCS-BLACKLIST) $(shell find -L $(DIRS-BLACKLIST-y) -name "*.c")
SRCS-y += $(shell find -L $(DIRS-y) -name "*.c")
SRCS = $(filter-out $(SRCS-BLACKLIST-y),$(SRCS-y))

# Extract compiler and options from menuconfig
##选择编译器，如果CONFIG_CC变量被定义，就用remove_quote去掉引号后赋值给CC，作为本次构建用的C编译器
ifneq ($(CONFIG_CC),)
CC = $(call remove_quote,$(CONFIG_CC))
endif
##构建编译参数
##把CONFIG_CC_OPT（编译器优化等参数）去掉引号后追加到CFLAGS_BUILD，例子：CONFIG_CC_OPT="-O2",则CFLAGS_BUILD += -O2
CFLAGS_BUILD += $(call remove_quote,$(CONFIG_CC_OPT))
##如果启用了LTO(Link Time Optimization)，追加-flto参数
CFLAGS_BUILD += $(if $(CONFIG_CC_LTO),-flto,)
##如果启用了调试选项，追加-Og -ggdb3（优化调试信息）
CFLAGS_BUILD += $(if $(CONFIG_CC_DEBUG),-Og -ggdb3,)
##如果启用了AddressSanitizer，追加-fsanitize=addresss
CFLAGS_BUILD += $(if $(CONFIG_CC_ASAN),-fsanitize=address,)

##拼接最终的C编译参数，并定义当前目标结构的宏
##CFLAGS +=....：把右侧内容追加到CFLAGS变量中，CFLAGS是GCC/Clang等C编译器的标准参数变量
##$(FLAGS_BUILD)：包含了所有构建相关的编译参数，比如优化选项（如-o2)、调试选项（如-Og -ggdb3）、LTO（如-flto)、ASAN（如-fsanitize=address)等
##-D__GUEST_ISA__=$(GUEST_ISA)，通过-D选项定义一个宏__GUEST_ISA__，其值为当前配置的架构名（如RISCV32,X86等等）
##这样在C代码中可以通过#ifdef __GUEST_ISA__或#if_GUEST_ISA__==riscv32进行条件编译，实现多架构适配
##-D是GCC/Clang等C编译器的宏定义参数，用于在编译时定义一个宏
##注：-D和后面的宏名、等号、宏值之间不能又空格，必须连携，这样才会被识别为宏
CFLAGS  += $(CFLAGS_BUILD) -D__GUEST_ISA__=$(GUEST_ISA)
##LDFLAGS是Makefile中用于指定链接器参数的标准变量，最终会传递给链接器(如ld或gcc的链接阶段)
##CFAGS_BUILD变量中包含了所有和构建相关的编译参数，比如优化选项（如-O2)、LTO（-flto）、调试选项（如-Og -ggdb3）、ASAN（如-fsanitize=addresss)等
##这行代码的作用是：把所有构建相关的编译参数也追加到链接参数中，保证链接阶段和编译阶段使用一致的优化、调试等选项，避免因为参数不一致导致的链接作物或运行时出问题
LDFLAGS += $(CFLAGS_BUILD)

# Include rules for menuconfig
include $(NEMU_HOME)/scripts/config.mk

.PHONY: unit-tests
unit-tests:
	$(MAKE) -C $(NEMU_HOME)/tests check

ifeq ($(CONFIG_TARGET_AM),y)
ifeq ($(NEMU_BUILD_LOCK_HELD),1)
include $(AM_HOME)/Makefile
LINKAGE += $(ARCHIVES)
else
# Abstract-Machine's makefile owns its own object/link rules and therefore
# cannot use scripts/build.mk's recursive wrapper.  Keep the public AM goals in
# an outer make and execute all requested AM work in one build+Kconfig lock
# transaction.  Config-only goals continue to be provided by config.mk above.
NEMU_AM_PUBLIC_GOALS := image image-dep archive run gdb c insert-arg build-arg \
  clean clean-all html
NEMU_AM_REQUESTED_GOALS := $(filter $(NEMU_AM_PUBLIC_GOALS),$(MAKECMDGOALS))
ifeq ($(strip $(MAKECMDGOALS)),)
NEMU_AM_REQUESTED_GOALS := image
.DEFAULT_GOAL := image
endif
ifneq ($(strip $(NEMU_AM_REQUESTED_GOALS)),)
.PHONY: $(NEMU_AM_REQUESTED_GOALS) __nemu_am_locked_build
$(NEMU_AM_REQUESTED_GOALS): __nemu_am_locked_build
	@:

__nemu_am_locked_build:
	@mkdir -p $(dir $(NEMU_BUILD_LOCK)) $(dir $(KCONFIG_LOCK))
	@python3 "$(NEMU_SAFE_FLOCK)" \
	  "$(NEMU_BUILD_LOCK)" "$(KCONFIG_LOCK)" -- \
	  $(MAKE) --no-print-directory NEMU_BUILD_LOCK_HELD=1 \
	    NEMU_OUTER_CONFIG_PARSE_ID="$(NEMU_CONFIG_PARSE_ID)" \
	    $(NEMU_AM_REQUESTED_GOALS)
endif
endif
else
# Include rules to build NEMU
# Berkeley SoftFloat is the executable F/D semantics for both RV32 and RV64.
# Its upstream build directory is also used by other projects and all
# specializations share the same object names.  Build the RISC-V specialization
# in a NEMU-private directory so an 8086 archive can never be mistaken for the
# architecture semantics selected here.
ifeq ($(CONFIG_RISCV_EXT_F),y)
SOFTFLOAT_HOME := $(YSYX_HOME)/tool/softfloat
SOFTFLOAT_BUILD_TEMPLATE := $(SOFTFLOAT_HOME)/build/Linux-x86_64-GCC
SOFTFLOAT_NEMU_BUILD_DIR := $(NEMU_HOME)/build/softfloat-RISCV
SOFTFLOAT_LIB := $(SOFTFLOAT_NEMU_BUILD_DIR)/softfloat.a
SOFTFLOAT_INPUTS := $(shell find $(SOFTFLOAT_HOME)/source -type f) \
  $(SOFTFLOAT_BUILD_TEMPLATE)/Makefile \
  $(SOFTFLOAT_BUILD_TEMPLATE)/platform.h
INC_PATH += $(SOFTFLOAT_HOME)/source/include
ARCHIVES += $(SOFTFLOAT_LIB)

$(SOFTFLOAT_LIB): $(SOFTFLOAT_INPUTS)
	@mkdir -p $(SOFTFLOAT_NEMU_BUILD_DIR)
	@python3 "$(NEMU_SAFE_FLOCK)" \
	  "$(SOFTFLOAT_NEMU_BUILD_DIR)/.build.lock" -- \
	  sh -eu -c 'if ! cmp -s "$$1" "$$2"; then cp "$$1" "$$2"; fi; \
	    "$$3" -C "$$4" -f "$$5" SOURCE_DIR="$$6" SPECIALIZE_TYPE=RISCV' \
	  sh "$(SOFTFLOAT_BUILD_TEMPLATE)/platform.h" \
	  "$(SOFTFLOAT_NEMU_BUILD_DIR)/platform.h" "$(MAKE)" \
	  "$(SOFTFLOAT_NEMU_BUILD_DIR)" "$(SOFTFLOAT_BUILD_TEMPLATE)/Makefile" \
	  "$(SOFTFLOAT_HOME)/source"
endif
include $(NEMU_HOME)/scripts/native.mk
endif
