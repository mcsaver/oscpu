menu "Memory Configuration"

config MBASE
  hex "Memory base address"
  default 0x0        if ISA_x86
  default 0x80000000

config MSIZE
  hex "Memory size"
  default 0x8000000

config PC_RESET_OFFSET
  hex "Offset of reset vector from the base of memory"
  default 0x100000 if ISA_x86
  default 0

choice
  prompt "Physical memory definition"
  default PMEM_GARRAY
config PMEM_MALLOC
  bool "Using malloc()"
config PMEM_GARRAY
  depends on !TARGET_AM
  bool "Using global array"
endchoice

config MEM_RANDOM
  depends on MODE_SYSTEM && !DIFFTEST && !TARGET_AM && !PERFORMANCE
  bool "Initialize the memory with random values"
  default y
  help
    This may help to find undefined behaviors.

config CACHE
  depends on TARGET_NATIVE_ELF
  bool "Enable ICache and DCache model"
  default y
  help
    在 vaddr 层启用透明的 ICache/DCache 模型；MMIO 仍直通 paddr 层，避免破坏设备副作用。

config CACHE_STATISTIC
  depends on CACHE && !PERFORMANCE
  bool "Print cache access counters"
  default y
  help
    控制退出时是否打印 ICache/DCache access/hit/miss/writeback 统计；关闭后仍会
    在 cache_statistic() 中执行必要的 DCache flush，避免统计开关改变功能结果。

config ICACHE_SIZE
  depends on CACHE
  int "ICache size in bytes"
  default 4096

config DCACHE_SIZE
  depends on CACHE
  int "DCache size in bytes"
  default 4096

config CACHE_LINE_SIZE
  depends on CACHE
  int "Cache line size in bytes"
  default 64

endmenu #MEMORY
