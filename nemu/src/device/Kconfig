menuconfig DEVICE
  depends on !TARGET_SHARE
  bool "Devices"
  default n
  help
    Provide device support for NEMU.

config DEVICE_UPDATE_CHECK_INTERVAL
  int "Guest instructions between host device polls"
  range 1 4096
  default 512 if PERFORMANCE
  default 64
  help
    device_update_after_inst() 先按 guest retired 指令数做一层粗粒度节流，
    再按宿主时间维持约 60Hz 的串口/RTC/VGA/SDL 刷新语义。Ubuntu
    performance 配置没有 VGA/keyboard/audio，适合使用更大的指令间隔来
    减少解释器热路径轮询开销；调试/交互配置保持较小默认值。

if DEVICE

config DEVICE_MAP_LEGACY
  bool "Use legacy AM device map (0xa0000000 family)"
  default n
  help
    设备地址默认走统一的 Linux/SoC 图 (见 include/device/device_address.h,
    与 AM/NPC 三方一致)。仅当为封存的 RV32 旧目标构建 difftest 参考时置 y,
    切回旧 AM 图 (serial 0xa00003f8 / rtc 0xa0000048 ...)。

config HAS_PORT_IO
  bool
  default y if ISA_x86
  default n

menuconfig HAS_SERIAL
  bool "Enable serial"
  default y

if HAS_SERIAL
config SERIAL_PORT
  depends on HAS_PORT_IO
  hex "Port address of the serial controller"
  default 0x3f8

config SERIAL_MMIO
  hex "MMIO address of the serial controller"
  # RV64 system mode follows Linux/platform/npc-rv64.yml and generated DTB.
  default 0x10000000 if ISA64 && MODE_SYSTEM && !TARGET_AM
  default 0xa00003f8

config SERIAL_INPUT_FIFO
  depends on !TARGET_AM
  bool "Enable input FIFO with /tmp/nemu.serial"
  default n

config SERIAL_INPUT_STDIN
  depends on !TARGET_AM
  bool "Attach host stdin to serial RX"
  default y if BATCH_MODE
  default n

config SERIAL_INPUT_HOST_POLL_INTERVAL
  depends on SERIAL_INPUT_STDIN || SERIAL_INPUT_FIFO
  int "Host device ticks between serial input polls"
  range 1 64
  default 4 if PERFORMANCE
  default 1
  help
    串口 RX 的宿主 stdin/FIFO 轮询间隔，以 device_update 的 60Hz host
    tick 为单位。Ubuntu performance 配置通常由 focused gate 分块注入输入，
    适合降低空闲时 select/read 频率；guest 主动读取 UART 寄存器时仍会立即
    轮询宿主输入，已进入 staging 的字节也会继续送入 16550 FIFO。
endif # HAS_SERIAL

menuconfig HAS_TIMER
  bool "Enable timer"
  default n if ISA64 && MODE_SYSTEM && !TARGET_AM
  default y

if HAS_TIMER
config RTC_PORT
  depends on HAS_PORT_IO
  hex "Port address of the timer"
  default 0x48

config RTC_MMIO
  hex "MMIO address of the timer"
  default 0xa0000048
endif # HAS_TIMER

menuconfig HAS_KEYBOARD
  bool "Enable keyboard"
  default n if ISA64 && MODE_SYSTEM && !TARGET_AM
  default y

if HAS_KEYBOARD
config I8042_DATA_PORT
  depends on HAS_PORT_IO
  hex "Port address of the keyboard controller"
  default 0x60

config I8042_DATA_MMIO
  hex "MMIO address of the keyboard controller"
  default 0xa0000060
endif # HAS_KEYBOARD

menuconfig HAS_VGA
  bool "Enable VGA"
  default n if ISA64 && MODE_SYSTEM && !TARGET_AM
  default y

if HAS_VGA
config FB_ADDR
  hex "Physical address of the VGA frame buffer"
  default 0xa1000000

config VGA_CTL_PORT
  depends on HAS_PORT_IO
  hex "Port address of the VGA controller"
  default 0x100

config VGA_CTL_MMIO
  hex "MMIO address of the VGA controller"
  default 0xa0000100

config VGA_SHOW_SCREEN
  bool "Enable SDL SCREEN"
  default y

choice
  prompt "Screen Size"
  default VGA_SIZE_400x300
config VGA_SIZE_400x300
  bool "400 x 300"
config VGA_SIZE_800x600
  bool "800 x 600"
endchoice
endif # HAS_VGA

if !TARGET_AM
menuconfig HAS_AUDIO
  bool "Enable audio"
  default n if ISA64 && MODE_SYSTEM
  default y

if HAS_AUDIO
config SB_ADDR
  hex "Physical address of the audio stream buffer"
  default 0xa1200000

config SB_SIZE
  hex "Size of the audio stream buffer"
  default 0x10000

config AUDIO_CTL_PORT
  depends on HAS_PORT_IO
  hex "Port address of the audio controller"
  default 0x200

config AUDIO_CTL_MMIO
  hex "MMIO address of the audio controller"
  default 0xa0000200
endif # HAS_AUDIO

menuconfig HAS_DISK
  bool "Enable disk"
  default y

if HAS_DISK
config DISK_CTL_PORT
  depends on HAS_PORT_IO
  hex "Port address of the disk controller"
  default 0x300

config DISK_CTL_MMIO
  hex "MMIO address of the disk controller"
  # Keep virtio-mmio block adjacent to UART as described by the Linux platform YAML.
  default 0x10001000 if ISA64 && MODE_SYSTEM
  default 0xa0000300

config DISK_IMG_PATH
  string "The path of disk image"
  default ""

config VIRTIO_BLK_ASYNC_COMPLETION_FAST_FLAG
  depends on HAS_DISK && !TARGET_AM
  bool "Skip empty virtio-blk async completion polls"
  default y if PERFORMANCE
  default n
  help
    native NEMU 的 virtio-blk worker 完成 host I/O 后仍由主线程写回
    used ring 和触发 PLIC IRQ。该选项用一个原子 pending flag 保护完成
    队列，空闲 device_update tick 不再反复进入 mutex；有完成项时仍由
    主线程按原路径写 guest PMEM/used ring，不改变 virtio 设备语义。
endif # HAS_DISK

menuconfig HAS_VIRTIO_RNG
  bool "Enable virtio-mmio random number generator"
  default n
  help
    Provide a small modern virtio-mmio RNG device for Linux hwrng.
    Ubuntu/systemd can then use /dev/hwrng instead of relying only on
    /chosen/rng-seed from the bootloader.

if HAS_VIRTIO_RNG
config VIRTIO_RNG_MMIO
  hex "MMIO address of the virtio rng controller"
  default 0x10002000
endif # HAS_VIRTIO_RNG

menuconfig HAS_VIRTIO_NET
  bool "Enable virtio-mmio network device"
  default n
  help
    Provide a small modern virtio-mmio network device for Linux. The
    first slice exposes a stable MAC address and consumes TX descriptors
    so Ubuntu can enumerate a virtio_net interface; host packet forwarding
    is a later device-backend step.

if HAS_VIRTIO_NET
config VIRTIO_NET_MMIO
  hex "MMIO address of the virtio net controller"
  default 0x10004000
endif # HAS_VIRTIO_NET

menuconfig HAS_GOLDFISH_RTC
  bool "Enable goldfish RTC"
  default n
  help
    Provide a small google,goldfish-rtc compatible MMIO device for Linux.
    This gives Ubuntu a wall-clock RTC device instead of relying only on
    CLINT mtime or systemd's software clock.

if HAS_GOLDFISH_RTC
config GOLDFISH_RTC_MMIO
  hex "MMIO address of the goldfish RTC controller"
  default 0x10003000
endif # HAS_GOLDFISH_RTC

menuconfig HAS_SYSCON_RESET
  bool "Enable syscon reset/poweroff"
  default n
  help
    Provide a small MMIO syscon register used by standard
    syscon-poweroff/syscon-reboot device-tree nodes. This lets Linux or
    OpenSBI finish a real shutdown path instead of relying on host kill.

if HAS_SYSCON_RESET
config SYSCON_RESET_MMIO
  hex "MMIO address of the syscon reset register"
  default 0x100000

config SYSCON_POWEROFF_VALUE
  hex "Poweroff value"
  default 0x5555

config SYSCON_REBOOT_VALUE
  hex "Reboot value"
  default 0x7777
endif # HAS_SYSCON_RESET

menuconfig HAS_SDCARD
  bool "Enable sdcard"
  default n

if HAS_SDCARD
config SDCARD_CTL_MMIO
  hex "MMIO address of the sdcard controller"
  default 0xa3000000

config SDCARD_IMG_PATH
  string "The path of sdcard image"
  default ""
endif # HAS_SDCARD
endif

endif # DEVICE
