# Minimal Linux 6.6 configuration input for the local RV64 L3 system layer.
# The build script applies this with KCONFIG_ALLCONFIG + allnoconfig and checks
# the resulting effective .config; this file is not itself signoff evidence.
CONFIG_64BIT=y
CONFIG_MMU=y
CONFIG_ARCH_RV64I=y
CONFIG_RISCV_SBI=y
CONFIG_RISCV_SBI_V01=y
CONFIG_RISCV_ISA_C=y
# CONFIG_FPU is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_ISA_ZBB is not set
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
# CONFIG_SMP is not set
CONFIG_NR_CPUS=1

CONFIG_EMBEDDED=y
CONFIG_EXPERT=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_LOCALVERSION="-rv64-l3"
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_MODULES is not set
# CONFIG_KALLSYMS is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_FTRACE is not set
# CONFIG_TRACING is not set
# CONFIG_PROFILING is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_IKCONFIG is not set
# CONFIG_IKCONFIG_PROC is not set

CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
CONFIG_LOG_BUF_SHIFT=12
CONFIG_BINFMT_ELF=y
# CONFIG_BINFMT_SCRIPT is not set
CONFIG_BLK_DEV_INITRD=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set

CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_HVC_RISCV_SBI=y
# CONFIG_VT is not set
# CONFIG_UNIX98_PTYS is not set

CONFIG_DEVTMPFS=y
# CONFIG_DEVTMPFS_MOUNT is not set
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
# CONFIG_TMPFS_XATTR is not set
# CONFIG_HUGETLBFS is not set
# CONFIG_CONFIGFS_FS is not set

CONFIG_POSIX_TIMERS=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_100=y
CONFIG_HZ=100
CONFIG_HZ_PERIODIC=y
# CONFIG_NO_HZ_IDLE is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_RISCV_SBI_CPUIDLE is not set

# CONFIG_NET is not set
# CONFIG_BLOCK is not set
# CONFIG_PCI is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_INPUT is not set
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MMC is not set
# CONFIG_RTC_CLASS is not set
# CONFIG_WATCHDOG is not set
# CONFIG_POWER_RESET is not set
# CONFIG_POWER_RESET_SYSCON is not set
# CONFIG_POWER_RESET_SYSCON_POWEROFF is not set

# CONFIG_SYSVIPC is not set
# CONFIG_POSIX_MQUEUE is not set
# CONFIG_CGROUPS is not set
# CONFIG_NAMESPACES is not set
# CONFIG_AIO is not set
# CONFIG_IO_URING is not set
# CONFIG_FUTEX is not set
# CONFIG_EPOLL is not set
# CONFIG_SIGNALFD is not set
# CONFIG_TIMERFD is not set
# CONFIG_EVENTFD is not set
# CONFIG_SECCOMP is not set
# CONFIG_SECURITY is not set
# CONFIG_CRYPTO is not set
CONFIG_RANDOM_TRUST_BOOTLOADER=y
