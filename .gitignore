*.o
*.d
__pycache__/
*.py[cod]

# 汇编源码属于设计/验证输入，不按扩展名全局忽略；build/、obj_dir/ 中的生成汇编由目录规则覆盖。
!*.s
!*.S

# 可再生的二级编译目录：仅匹配目录，避免误伤 build-*.py 等工程脚本。
**/build/
**/build-*/
**/build_*/
**/obj_dir/
**/CMakeFiles/

# 名称含 build 但承载真实构建描述/源码的目录，继续纳入版本控制。
!tool/softfloat/build/
!tool/softfloat/build/**
!ysyxSoC/rocket-chip/dependencies/chisel/.github/workflows/build-scala-cli-template/
!ysyxSoC/rocket-chip/dependencies/chisel/.github/workflows/build-scala-cli-template/**

/tmp/
*oss-cad-suite/
oss-cad-suite-linux-x64-*.tgz
*jcs/

# yosys-sta：保留本地工具/结果目录忽略，但跟踪可复现的 flow 入口与脚本。
/yosys-sta/*
!/yosys-sta/Makefile
!/yosys-sta/scripts/
!/yosys-sta/scripts/common.tcl
!/yosys-sta/scripts/default.sdc
!/yosys-sta/scripts/pdk/
!/yosys-sta/scripts/pdk/icsprout55.tcl
!/yosys-sta/scripts/pdk/nangate45.tcl
!/yosys-sta/scripts/sta.tcl
!/yosys-sta/scripts/yosys.tcl
am-kernels/build/regression/
npc/single/.config
npc/single/.config.old
npc/single/build/
npc/single/include/config/
npc/single/include/generated/
npc/.platform
npc/sim/.config
npc/sim/.config.old
npc/sim/include/config/
npc/sim/include/generated/
npc/soc/.config
npc/soc/.config.old
npc/soc/build/
npc/soc/gmon.out
npc/soc/include/config/
npc/soc/include/generated/
npc/soc/perf/results/
npc/soc/testbench/build/
npc/rv64/.config
npc/rv64/.config.old
npc/rv64/.linux-defconfig.stamp
npc/rv64/.linux-trace-defconfig.stamp
npc/rv64/build*/
npc/rv64/gmon.out
npc/rv64/include/config/
npc/rv64/include/generated/
npc/rv64/perf/results/
npc/rv64/testbench/build*/
npc/rv64/testsuites/core-tests/**
!npc/rv64/testsuites/core-tests/
!npc/rv64/testsuites/core-tests/.gitkeep
# 允许外层仓库接管 vendored riscv-tests；其内部构建产物继续由该目录自己的 .gitignore 过滤。
!npc/rv64/testsuites/core-tests/src/
!npc/rv64/testsuites/core-tests/src/riscv-tests/
!npc/rv64/testsuites/core-tests/src/riscv-tests/**

# Vivado/FPGA 工程生成物：保留 fpga/Makefile、scripts/、constraints/ 等入口文件。
fpga/.Xil/
fpga/vivado/
fpga/reports/
fpga/filelists/*.f
fpga/**/*.jou
fpga/**/*.log
fpga/**/*.str
fpga/**/*.rpt
fpga/**/*.dcp
fpga/**/*.wdb
fpga/**/*.pb
fpga/**/*.vdi
fpga/**/*.backup.jou
fpga/**/*.backup.log

# RV64 Linux/OpenSBI/Ubuntu 构建产物可能包含 GB 级源码、镜像和日志，禁止纳入 Git。
Linux/build/
Linux/env/*
!Linux/env/README.md
Linux/tools/build/
Linux/tools/generated/
Linux/tools/images/
Linux/tools/initramfs/

# AI 开发环境需要随仓库同步；这些 allowlist 用来覆盖本机或工具引入的宽泛忽略规则。
!.github/
!.github/**

# 上述 allowlist 之后重新屏蔽 AI/task-run 自身生成的 Python 二级产物。
# 规则必须位于 !.github/** 之后，否则 Git 的 last-match 语义会重新放行这些文件。
.github/**/__pycache__/
.github/**/*.py[cod]

# AI runtime cache
.github/cache/**
!.github/cache/.gitkeep

# AI runtime artifact store: keep large or volatile payloads outside source.
.github/runtime-artifacts/**
!.github/runtime-artifacts/.gitkeep

# 一次性审计目录和重型 task-run evidence 不进入 tracked source。
.github/shujuku_aireview/**
.github/task-runs/.async/**
.github/task-runs/**/build/
.github/task-runs/**/build-*/
.github/task-runs/**/build_*/
.github/task-runs/**/obj_dir/
.github/task-runs/**/CMakeFiles/
.github/task-runs/*.log
.github/task-runs/**/*.log
.github/task-runs/**/evidence/**
!.github/task-runs/**/evidence-index.md
!.github/task-runs/**/run-manifest.json
.github/task-runs/**/evidence/*.vcd
.github/task-runs/**/evidence/*.fst
.github/task-runs/**/evidence/*.fsdb
.github/task-runs/**/evidence/*.wlf
.github/task-runs/**/evidence/*.vpd
.github/task-runs/**/evidence/*.ghw
.github/task-runs/**/evidence/*.pcap
.github/task-runs/**/evidence/*.qcow2
.github/task-runs/**/evidence/*.img
.github/task-runs/**/evidence/*.raw
.github/task-runs/**/evidence/*.dump
.github/task-runs/**/evidence/*.trace
.github/task-runs/**/evidence/*.itrace
.github/task-runs/**/evidence/*.elf
.github/task-runs/**/evidence/*.bin
.github/task-runs/**/nemu-systemd-*.riscv64
.github/task-runs/**/nemu-systemd-*.b64
.github/task-runs/**/guest-check*.cmd
.github/task-runs/**/rootfs-overlay.raw
.github/task-runs/**/nemu.serial

# Legacy archive: Git 只保留索引，不保留旧产物实体。
.github/archive/**
!.github/archive/
!.github/archive/**/
!.github/archive/**/ARCHIVE_MANIFEST.md
!.github/archive/**/CHECKSUMS.txt
!.github/archive/**/POINTERS.md

# DB backups: 只保留 manifest/snapshot 指针，不保留 volatile dump。
.github/db-backup/**
!.github/db-backup/
!.github/db-backup/manifest.json
!.github/db-backup/stored-snapshot/
!.github/db-backup/stored-snapshot/manifest.json
!.github/db-backup/task-runs/
!.github/db-backup/task-runs/manifest.json

!/AGENTS.md
!/CLAUDE.md
!/GEMINI.md
!/CONVENTIONS.md
!/.windsurfrules
!/.cursor/
!/.cursor/rules/
!/.cursor/rules/agents.mdc

# 商业交付：deliverables 只放交付源；生成包放 dist 且不进 Git。
!.github/archive/
!.github/archive/legacy-ai-dev-env-2026-06-13/
!deliverables/
!deliverables/ai-dev-env-commercial-v1/
!deliverables/ai-dev-env-commercial-v1/**
deliverables/**/package/**
dist/**
build/**

# Testbench 从子目录启动时产生的误置 task-run；正式证据统一写到仓库根 .github/task-runs/。
npc/rv64/testbench/.github/
