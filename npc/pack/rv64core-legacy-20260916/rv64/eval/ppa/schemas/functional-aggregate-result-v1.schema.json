{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "npc-rv64-functional-aggregate-result-v1.schema.json",
  "title": "NPC RV64 current functional aggregate result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "design_id", "cohort_id", "status", "exit_code",
    "canonical_command", "aggregate", "raw_log", "mutation_summary",
    "counts", "checks"
  ],
  "properties": {
    "schema": {"const": "npc-rv64-functional-aggregate-result-v1"},
    "design_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "cohort_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "FAIL"]},
    "exit_code": {"type": "integer"},
    "canonical_command": {"type": "string", "minLength": 1},
    "aggregate": {"$ref": "#/$defs/artifact"},
    "raw_log": {"$ref": "#/$defs/artifact"},
    "mutation_summary": {"$ref": "#/$defs/artifact"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_required", "module_passed", "official_required",
        "official_passed", "am_required", "am_passed", "difftest_mismatches",
        "evidence_mutations_compiled", "evidence_mutations_rejected"
      ],
      "properties": {
        "module_required": {"type": "integer", "minimum": 1},
        "module_passed": {"type": "integer", "minimum": 0},
        "official_required": {"const": 177},
        "official_passed": {"const": 177},
        "am_required": {"type": "integer", "minimum": 1},
        "am_passed": {"type": "integer", "minimum": 1},
        "difftest_mismatches": {"const": 0},
        "evidence_mutations_compiled": {"type": "integer", "minimum": 1},
        "evidence_mutations_rejected": {"type": "integer", "minimum": 1}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "detail"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "GAP"]},
          "detail": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
