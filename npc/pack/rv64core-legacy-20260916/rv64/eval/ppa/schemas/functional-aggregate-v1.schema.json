{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "npc-rv64-functional-aggregate-v1.schema.json",
  "title": "NPC RV64 same-cohort functional aggregate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "design_id", "cohort_id", "simulator", "configuration",
    "module", "official", "am", "difftest", "benchmarks"
  ],
  "properties": {
    "schema": {"const": "npc-rv64-functional-aggregate-v1"},
    "design_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "cohort_id": {"type": "string", "minLength": 1},
    "simulator": {"$ref": "#/$defs/artifact"},
    "configuration": {"$ref": "#/$defs/artifact"},
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "required", "passed", "failed", "tests"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "required": {"type": "integer", "minimum": 1},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "test_id", "compile_rc", "simulation_rc", "pass_markers",
              "fail_markers", "log"
            ],
            "properties": {
              "test_id": {"type": "string", "pattern": "^tb_[A-Za-z0-9_]+$"},
              "compile_rc": {"type": "integer"},
              "simulation_rc": {"type": "integer"},
              "pass_markers": {"type": "integer", "minimum": 0},
              "fail_markers": {"type": "integer", "minimum": 0},
              "log": {"$ref": "#/$defs/artifact"}
            }
          }
        }
      }
    },
    "official": {
      "allOf": [
        {"$ref": "#/$defs/suite"},
        {
          "properties": {
            "required": {"const": 177},
            "passed": {"const": 177},
            "failed": {"const": 0},
            "inventory": {"minItems": 177, "maxItems": 177}
          }
        }
      ]
    },
    "am": {
      "allOf": [
        {"$ref": "#/$defs/suite"},
        {
          "required": ["difftest_enabled"],
          "properties": {
            "required": {"const": 59},
            "passed": {"const": 59},
            "failed": {"const": 0},
            "inventory": {"minItems": 59, "maxItems": 59},
            "difftest_enabled": {"const": true}
          }
        }
      ]
    },
    "difftest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "applicable", "mismatches", "image", "log"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "applicable": {"const": true},
        "mismatches": {"const": 0},
        "image": {"$ref": "#/$defs/artifact"},
        "log": {"$ref": "#/$defs/artifact"}
      }
    },
    "benchmarks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coremark", "dhrystone"],
      "properties": {
        "coremark": {
          "allOf": [
            {"$ref": "#/$defs/benchmark"},
            {
              "required": ["iterations", "crc", "good_traps"],
              "properties": {
                "iterations": {"const": 10},
                "crc": {"const": "0xfcaf"},
                "good_traps": {"const": 1}
              }
            }
          ]
        },
        "dhrystone": {
          "allOf": [
            {"$ref": "#/$defs/benchmark"},
            {
              "required": ["runs", "good_traps"],
              "properties": {
                "runs": {"const": 10000},
                "good_traps": {"const": 1}
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command", "required", "passed", "failed", "inventory", "image", "log"
      ],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "required": {"type": "integer", "minimum": 1},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "inventory": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "image": {"$ref": "#/$defs/artifact"},
        "log": {"$ref": "#/$defs/artifact"},
        "difftest_enabled": {"type": "boolean"}
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "return_code", "image", "log"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "return_code": {"const": 0},
        "image": {"$ref": "#/$defs/artifact"},
        "log": {"$ref": "#/$defs/artifact"},
        "iterations": {"type": "integer"},
        "crc": {"type": "string"},
        "runs": {"type": "integer"},
        "good_traps": {"type": "integer"}
      }
    }
  }
}
