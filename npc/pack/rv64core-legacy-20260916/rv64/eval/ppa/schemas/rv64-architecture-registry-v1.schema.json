{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "npc-rv64-architecture-registry-v1.schema.json",
  "title": "NPC RV64 architecture ownership registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "single_entry",
    "scope",
    "bpu_physical_experiment_state",
    "owners",
    "owner_rules",
    "file_overrides",
    "owner_globs",
    "capabilities",
    "physical_boundaries",
    "run_parameter_contract",
    "physical_configurations",
    "evidence",
    "architecture_nodes",
    "architecture_edges"
  ],
  "$defs": {
    "fpOocChildContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rtl",
        "source_closure",
        "compile_sources",
        "top_instance",
        "clock_port",
        "synchronous_controls",
        "input_ports",
        "output_ports",
        "path_classes",
        "top_boundary_contract",
        "forbidden_timing_exceptions"
      ],
      "properties": {
        "rtl": {"type": "string", "pattern": "^npc/rv64/vsrc/execute/OooFp[A-Za-z0-9]+\\.v$"},
        "source_closure": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^npc/rv64/vsrc/"}
        },
        "compile_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^npc/rv64/vsrc/.+\\.(v|sv)$"
          }
        },
        "top_instance": {"type": "string", "pattern": "^u_[a-z0-9_]+$"},
        "clock_port": {"const": "clk"},
        "synchronous_controls": {"const": ["rst", "flush_i"]},
        "input_ports": {
          "type": "object",
          "minProperties": 6,
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "output_ports": {
          "type": "object",
          "minProperties": 4,
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "path_classes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "port_to_register",
            "register_to_register",
            "register_to_port",
            "synchronous_control_to_register",
            "top_boundary"
          ],
          "properties": {
            "port_to_register": {"const": "required"},
            "register_to_register": {"enum": ["required", "not_applicable_single_stage"]},
            "register_to_port": {"const": "required"},
            "synchronous_control_to_register": {"const": "required"},
            "top_boundary": {"type": "string", "minLength": 1}
          }
        },
        "top_boundary_contract": {
          "type": "object",
          "required": ["source_instance_path", "source_object_class", "source_port_families", "endpoint"]
        },
        "forbidden_timing_exceptions": {
          "const": ["false_path", "multicycle_path", "recovery", "removal", "pi_to_po"]
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "npc-rv64-architecture-registry-v1"
    },
    "single_entry": {
      "const": "npc/rv64/ARCHITECTURE.md"
