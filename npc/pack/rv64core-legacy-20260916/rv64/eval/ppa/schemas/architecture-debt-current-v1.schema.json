{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "npc-rv64-architecture-debt-current-v1.schema.json",
  "title": "NPC RV64 current architecture-debt receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "design_id",
    "rtl_file_count",
    "cohort_id",
    "closed_debts",
    "excluded_debts",
    "debt_status",
    "support",
    "inputs",
    "metrics",
    "prerequisites",
    "evidence_reuse_contract",
    "promotion"
  ],
  "properties": {
    "schema": {
      "const": "npc-rv64-architecture-debt-current-v1"
    },
    "status": {
      "const": "PASS"
    },
    "design_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rtl_file_count": {
      "const": 146
    },
    "cohort_id": {
      "const": "full-core-single-hart-rv64-dual-issue-ooo-v1"
    },
    "closed_debts": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "excluded_debts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "debt_status": {
      "type": "object",
      "minProperties": 20,
      "maxProperties": 20,
      "additionalProperties": {
        "enum": [
          "CLOSED_CURRENT_DESIGN",
          "EXCLUDED_BY_COHORT"
        ]
      }
    },
    "support": {
      "type": "object",
      "minProperties": 16,
      "maxProperties": 16,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      }
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/artifact"
      }
    },
    "metrics": {
      "type": "object"
    },
    "prerequisites": {
      "type": "object"
    },
    "evidence_reuse_contract": {
      "type": "object"
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture_debt_ledger",
        "whole_architecture",
        "system_recertification",
        "ppa"
      ],
      "properties": {
        "architecture_debt_ledger": {
          "const": "RESOLVED_CURRENT_DESIGN"
        },
        "whole_architecture": {
          "const": "RED"
        },
        "system_recertification": {
          "const": "PASS_CURRENT_CONFIG"
        },
        "ppa": {
          "const": "UNPROMOTED"
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
