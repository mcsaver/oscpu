# trace 配置：用于 Linux boot 卡点定位，不作为性能基线。
CONFIG_CC_GPP=y
CONFIG_CC="g++"
CONFIG_CC_O3=y
CONFIG_CC_OPT="-O3"
CONFIG_CC_DEBUG=y
CONFIG_NPC_DEFAULT_MAX_CYCLES=20000000
CONFIG_NPC_DEFAULT_LOG_PATH="build/linux-logs/npc-trace.log"
CONFIG_NPC_BATCH_MODE=y
CONFIG_NPC_STDIN_KEYBOARD=n
CONFIG_NPC_HAS_VGA=n
CONFIG_NPC_TRACE_BY_DEFAULT=n
CONFIG_NPC_COLORED_LOG=y
CONFIG_NPC_LOG_FILE=y
CONFIG_NPC_PROGRESS_BY_DEFAULT=y
CONFIG_NPC_DEFAULT_PROGRESS_INTERVAL=1000000
CONFIG_NPC_DIFFTEST=n
CONFIG_NPC_SDB=y
CONFIG_NPC_EXPR=y
CONFIG_NPC_WATCHPOINT=y
CONFIG_NPC_TEXT_TRACE=y
CONFIG_NPC_ITRACE_BY_DEFAULT=n
CONFIG_NPC_ITRACE_COND="true"
CONFIG_NPC_MTRACE_BY_DEFAULT=n
CONFIG_NPC_DTRACE_BY_DEFAULT=n
