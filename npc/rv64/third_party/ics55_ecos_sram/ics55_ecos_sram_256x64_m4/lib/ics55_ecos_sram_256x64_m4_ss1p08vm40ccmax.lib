library(ics55_ecos_sram_256x64_m4_ss1p08vm40ccmax) {



    delay_model             : table_lookup ;
    time_unit               : "1ns" ;
    voltage_unit            : "1V" ;
    current_unit            : "1mA" ;
    leakage_power_unit      : "1pW" ;
