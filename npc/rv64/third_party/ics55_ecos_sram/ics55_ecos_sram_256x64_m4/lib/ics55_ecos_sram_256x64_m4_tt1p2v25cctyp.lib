library(ics55_ecos_sram_256x64_m4_tt1p2v25cctyp) {



    delay_model             : table_lookup ;
    time_unit               : "1ns" ;
    voltage_unit            : "1V" ;
    current_unit            : "1mA" ;
    leakage_power_unit      : "1pW" ;
