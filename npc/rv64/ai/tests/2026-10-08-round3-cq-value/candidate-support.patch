+          cvp_source_preg[cvp_slot][cvp_src] = CVP_PREG_W'(cvp_preg);
+          cvp_source_tag[cvp_slot][cvp_src] = cvp_producer_tag[cvp_preg];
+          cvp_source_known[cvp_slot][cvp_src] = cvp_known[cvp_preg] && cvp_preg != 0 &&
+              `R64_CVP_I.enq_src_used_i[cvp_lane*3+cvp_src] &&
+              !`R64_CVP_I.enq_src_fp_i[cvp_lane*3+cvp_src];
