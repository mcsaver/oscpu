+            if (cvp_waiting) cvp_wait_front_to_issue[cvp_bkt] = cvp_wait_front_to_issue[cvp_bkt] + 1;
+            cvp_delay = profile_cycles_q - cvp_front_cycle[cvp_preg];
+            cvp_bkt = cvp_delay >= 32 ? 32 : int'(cvp_delay);
+            cvp_front_to_read[cvp_bkt] = cvp_front_to_read[cvp_bkt] + 1;
