+      cvp_tag_now = `R64_CVP_B.external_tag_i[cvp_lane*CVP_TAG_W+:CVP_TAG_W];
+      cvp_slot = int'(cvp_tag_now[CVP_ROB_W-1:0]);
+      cvp_preg = int'(cvp_ticket[5:0]);
