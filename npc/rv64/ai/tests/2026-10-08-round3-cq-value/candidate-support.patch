+      cvp_source_known[cvp_i] = 0;
+      for (cvp_j = 0; cvp_j < 3; cvp_j = cvp_j + 1) begin
+        cvp_source_preg[cvp_i][cvp_j] = 0; cvp_source_tag[cvp_i][cvp_j] = 0;
+      end
+    end
+    for (cvp_i = 0; cvp_i < 4; cvp_i = cvp_i + 1) cvp_read_source[cvp_i] = 0;
+    for (cvp_i = 0; cvp_i < 33; cvp_i = cvp_i + 1) begin
+      cvp_front_to_issue[cvp_i] = 0; cvp_front_to_read[cvp_i] = 0;
+      cvp_wait_front_to_issue[cvp_i] = 0; cvp_wait_front_to_read[cvp_i] = 0;
