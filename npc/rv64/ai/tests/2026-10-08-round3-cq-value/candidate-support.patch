+      cvp_preg = int'(`R64_CVP_R.alloc_pnew_i[cvp_lane*CVP_PREG_W+:CVP_PREG_W]);
+      if (`R64_CVP_B.birth_w[cvp_lane] && `R64_CVP_R.alloc_rd_write_i[cvp_lane] &&
+          !`R64_CVP_R.alloc_rd_fp_i[cvp_lane] && cvp_preg != 0) begin
+        cvp_known[cvp_preg] = 1;
+        cvp_producer_tag[cvp_preg] = `R64_CVP_B.birth_tag_w[cvp_lane*CVP_TAG_W+:CVP_TAG_W];
+        cvp_front_seen[cvp_preg] = 0; cvp_early_seen[cvp_preg] = 0; cvp_wb_seen[cvp_preg] = 0;
+        cvp_front_cycle[cvp_preg] = 0; cvp_early_cycle[cvp_preg] = 0; cvp_wb_cycle[cvp_preg] = 0;
+      end
+    end
+    for (cvp_lane = 0; cvp_lane < 2; cvp_lane = cvp_lane + 1) begin
+      cvp_tag_now = `R64_CVP_B.birth_tag_w[cvp_lane*CVP_TAG_W+:CVP_TAG_W];
