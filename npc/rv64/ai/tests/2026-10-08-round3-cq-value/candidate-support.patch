+// Birth-owned scoreboard: no post-release lookup into the DUT LSQ.
+reg [7:0] vt_expected[0:511];
+reg vt_eligible[0:511];
+integer vt_checks = 0, vt_good = 0, vt_bad = 0;
+integer vt_l, vt_tag;
+reg [7:0] vt_fn;
+reg [63:0] vt_addr;
+always @(posedge clk) begin
+  if (!rst && CQ_VALUE_BYPASS) begin
+    for (vt_l = 0; vt_l < 2; vt_l = vt_l + 1) begin
+      if (in_fire[vt_l]) begin
+        vt_tag = int'(in_tag[vt_l*9+:9]);
+        vt_fn = in_uop[vt_l*`R64_UOP_W+196+:8];
+        vt_addr = operand[vt_l*192+:64];
+        vt_expected[vt_tag] = reserve_ticket[vt_l*8+:8];
+        vt_eligible[vt_tag] = !vt_fn[7] && !vt_fn[5] &&
+            reserve_ticket[vt_l*8+7] && !reserve_ticket[vt_l*8+6] &&
+            (|reserve_ticket[vt_l*8+:6]) && !ticket_reserved_class &&
+            vt_addr[11:8] != 4'he && vt_addr[11:8] != 4'hf &&
+            ((vt_addr & ((64'b1 << vt_fn[1:0])-1)) == 0);
+      end
+      if (out_valid[vt_l]) begin
+        vt_tag = int'(out_tag[vt_l*9+:9]);
+        if (out_value_ticket[vt_l*9+8] !==
+            (vt_eligible[vt_tag] && !out_result[vt_l*`R64_RESULT_W+64]))
+          $fatal(1, "LSU early qualification crossed owner tag=%0d ticket=%h", vt_tag,
+                 out_value_ticket[vt_l*9+:9]);
+        if (!out_result[vt_l*`R64_RESULT_W+64] &&
+            out_value_ticket[vt_l*9+:8] !== vt_expected[vt_tag])
+          $fatal(1, "LSU ticket identity lost after LSQ release tag=%0d", vt_tag);
+        vt_checks = vt_checks + 1;
+        if (out_value_ticket[vt_l*9+8]) vt_good = vt_good + 1;
+        else vt_bad = vt_bad + 1;
+      end
+    end
+  end
+end
+
+task run_value_ticket;
+  integer limit, forwarded;
+  begin
+    if (!CQ_VALUE_BYPASS) $fatal(1, "value-ticket fixture requires CQ_VALUE_BYPASS=1");
+    trigger_test = 1;
+    tr_delay = 1; mem_delay = 1;
+    // Actual successful integer load, held after canonical LSQ release.
+    out_ready = 0;
+    enqueue(0, 0, 0, 8'h03, 0, memory[0], 0, 0);
+    limit = 0;
+    while (out_valid == 0 && limit < 100) begin @(negedge clk); limit = limit + 1; end
+    if (out_valid == 0) $fatal(1, "ticket held CQ fixture timed out");
+    repeat (12) @(negedge clk);
+    out_ready = 3; wait_result(0); rb_drain;
+    // Zero destination, non-writing owner and FP destination never offer early value.
+    ticket_override = 1;
+    override_ticket = {8'b0, 1'b1, 1'b0, 6'b0};
+    enqueue(1, 8, 0, 8'h03, 0, memory[1], 0, 0); wait_result(1); rb_drain;
+    override_ticket = {8'b0, 1'b0, 1'b0, 6'd19};
+    enqueue(2, 16, 0, 8'h03, 0, memory[2], 0, 0); wait_result(2); rb_drain;
+    override_ticket = {8'b0, 1'b1, 1'b1, 6'd20};
+    enqueue(3, 24, 0, 8'h03, 0, memory[3], 0, 0); wait_result(3); rb_drain;
+    ticket_override = 0;
+    // Reserved physical class is not ordinary RAM, even though not IO class2.
+    ticket_reserved_class = 1;
+    enqueue(4, 32, 0, 8'h03, 0, memory[4], 0, 0); wait_result(4); rb_drain;
+    ticket_reserved_class = 0;
+    // Full-forward result takes identity before its original LSQ row is released.
+    head_valid = 0;
+    enqueue(5, 64, 64'h0123456789abcdef, 8'h23, 0, 0, 0, 0);
+    repeat (20) @(negedge clk);
+    forwarded = memcount;
+    enqueue(6, 64, 0, 8'h03, 0, 64'h0123456789abcdef, 0, 0);
+    wait_result(6);
+    if (memcount != forwarded) $fatal(1, "ticket full-forward fixture used physical memory");
+    killed[5] = 1; kill = 32'b1 << 5;
+    @(negedge clk); kill = 0; head_valid = 1; rb_drain;
+    if (vt_good < 2 || vt_bad < 4) $fatal(1, "ticket eligibility coverage vacuous");
+    $display("[PASS] tb_r64_lsu value-ticket checks=%0d eligible=%0d excluded=%0d fullforward=1",
+             vt_checks, vt_good, vt_bad);
+    $finish;
+  end
+endtask
