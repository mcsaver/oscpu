+// CQ early value diagnostic: two ordinary loads feed both data and shift-count
+// operands; all 64 shift counts, RV64 word sign extension and repeated tag/preg
+// reuse are checked. Run both normally and with the system harness --stalls.
+// Independent expected operands are register constants / the loop index, so a
+// stale load-count bypass at the RR predecode edge cannot pass by coincidence.
+.section .text
+.globl _start
+.option norelax
+_start:
+  li s0, 8
+  li s1, 0x8765432187654321
+  li s2, -1
+outer:
+  la s3, counts
+  li s4, 0
+.globl load_shift_begin
+load_shift_begin:
+  ld t0, 0(s3)
+  ld t1, 512(s3)
+  sll t2, t1, t0
+  sll a1, s1, s4
+  bne t2, a1, fail_sll
+  srl t3, t1, t0
+  srl a2, s1, s4
+  bne t3, a2, fail_srl
+  sra t4, t1, t0
+  sra a3, s1, s4
+  bne t4, a3, fail_sra
+  sllw t5, t1, t0
+  sllw a4, s1, s4
+  bne t5, a4, fail_sllw
+  srlw t6, t1, t0
+  srlw a5, s1, s4
+  bne t6, a5, fail_srlw
+  sraw a6, t1, t0
+  sraw a7, s1, s4
+  bne a6, a7, fail_sraw
+  // Adjacent birth can encounter already-front CQ producers (DEFER_READY).
+  ld t0, 0(s3)
+  add t1, t0, t0
+  add a1, s4, s4
+  bne t1, a1, fail_add
+  // Ordinary signed load feeding both a compare and an arithmetic operation.
+  lw t0, 512(s3)
+  sext.w a2, s1
+  bne t0, a2, fail_lw
+  add t1, t0, s2
+  add a3, a2, s2
+  bne t1, a3, fail_add
+  addi s3, s3, 8
+  addi s4, s4, 1
+  li t6, 64
+  bne s4, t6, load_shift_begin
+  addi s0, s0, -1
+  bnez s0, outer
+.globl load_shift_end
+load_shift_end:
+  li a0, 0
+  ebreak
+fail_sll: li a0, 1
+  ebreak
+fail_srl: li a0, 2
+  ebreak
+fail_sra: li a0, 3
+  ebreak
+fail_sllw: li a0, 4
+  ebreak
+fail_srlw: li a0, 5
+  ebreak
+fail_sraw: li a0, 6
+  ebreak
+fail_add: li a0, 7
+  ebreak
+fail_lw: li a0, 8
+  ebreak
