+        cvp_consumer_pc[cvp_slot] = `R64_CVP_I.enq_payload_i[cvp_lane*`R64_UOP_W+:64];
+        cvp_issued[cvp_slot] = 0;
+        for (cvp_src = 0; cvp_src < 3; cvp_src = cvp_src + 1) begin
