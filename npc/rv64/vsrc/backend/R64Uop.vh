`define R64_F_SH3ADD 8'd18
`define R64_F_ANDN 8'd19
`define R64_F_ORN 8'd20
`define R64_F_XNOR 8'd21
`define R64_F_ROL 8'd22
`define R64_F_ROR 8'd23
`define R64_F_MIN 8'd24
`define R64_F_MAX 8'd25
`define R64_F_MINU 8'd26
`define R64_F_MAXU 8'd27
`define R64_F_BSET 8'd31
`define R64_F_BCLR 8'd32
