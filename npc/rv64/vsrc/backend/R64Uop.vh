`ifndef R64_UOP_VH
`define R64_UOP_VH
// Execution payload: one category-dependent 64-bit ARG, no duplicate immediate/
// prediction field. Branch immediates are fixed wires from normalized CMD.
`define R64_UOP_W 218
`define R64_U_PC 63:0
`define R64_U_ARG 127:64
`define R64_U_CMD 191:128
`define R64_U_LEN 195:192
`define R64_U_FUNC 203:196
`define R64_U_FLAGS 211:204
`define R64_U_CAUSE 217:212
`define R64_U_WORD 204
`define R64_U_OP1_PC 205
`define R64_U_OP1_ZERO 206
`define R64_U_OP2_ARG 207
`define R64_U_EXCEPTION 208
`define R64_META_W 204
`define R64_M_PC 63:0
`define R64_M_RAW 127:64
`define R64_M_NPC 191:128
`define R64_M_LEN 195:192
`define R64_M_KIND 203:196
`define R64_RESULT_W 140
`define R64_R_DATA 63:0
`define R64_R_EXCEPTION 64
`define R64_R_CAUSE 70:65
`define R64_R_TVAL 134:71
`define R64_R_FFLAGS 139:135
`define R64_C_ALU 3'd0
`define R64_C_BRANCH 3'd1
`define R64_C_MDU 3'd2
`define R64_C_FP 3'd3
`define R64_C_MEM 3'd4
`define R64_C_SERIAL 3'd5
`define R64_K_NORMAL 8'd0
`define R64_K_BRANCH 8'd1
`define R64_K_LOAD 8'd2
`define R64_K_STORE 8'd3
`define R64_K_AMO 8'd4
`define R64_K_FP 8'd5
`define R64_K_CSR 8'd6
`define R64_K_ECALL 8'd7
`define R64_K_EBREAK 8'd8
`define R64_K_MRET 8'd9
`define R64_K_SRET 8'd10
`define R64_K_WFI 8'd11
`define R64_K_FENCE 8'd12
`define R64_K_FENCEI 8'd13
`define R64_K_SFENCE 8'd14
`define R64_K_TENSOR 8'd15
`define R64_K_FAULT 8'd16
// ALU base operations retain the conventional funct3 layout; extension
// operations are final operations, so execution never re-decodes opcode.
`define R64_F_ADD 8'd0
`define R64_F_SLL 8'd1
`define R64_F_SLT 8'd2
`define R64_F_SLTU 8'd3
`define R64_F_XOR 8'd4
