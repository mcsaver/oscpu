    8001b5d8:	00a79793          	slli	x15,x15,0xa
    8001b5dc:	3bf78793          	addi	x15,x15,959

# Testcase: shadow CSR test for writing mstatus and reading sstatus with mask 0xcffffffcf
  LI(x12, 0xcffffffcf) # mask specifying bits to keep
    8001b5e0:	00000637          	lui	x12,0x0
    8001b5e4:	00c60613          	addi	x12,x12,12 # c <edge2+0x2>
    8001b5e8:	00b61613          	slli	x12,x12,0xb
