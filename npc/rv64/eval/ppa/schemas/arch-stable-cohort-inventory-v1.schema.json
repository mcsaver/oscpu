{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "npc-rv64-arch-stable-cohort-inventory-v1.schema.json",
  "title": "NPC RV64 ARCH_STABLE normative cohort inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "design_id", "cohort_id", "freeze_inputs", "run_parameters"],
  "properties": {
    "schema": {"const": "npc-rv64-arch-stable-cohort-inventory-v1"},
    "design_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "cohort_id": {"type": "string", "minLength": 1},
    "freeze_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config", "generated_headers", "filelists", "specifications",
        "test_sources", "tool_versions", "liberty", "macros",
        "constraints", "images", "binaries", "workflow"
      ],
      "properties": {
        "config": {"$ref": "#/$defs/artifactList"},
        "generated_headers": {"$ref": "#/$defs/artifactList"},
        "filelists": {"$ref": "#/$defs/artifactList"},
        "specifications": {"$ref": "#/$defs/artifactList"},
        "test_sources": {"$ref": "#/$defs/artifactList"},
        "tool_versions": {"$ref": "#/$defs/artifactList"},
        "liberty": {"$ref": "#/$defs/artifactList"},
        "macros": {"$ref": "#/$defs/artifactList"},
        "constraints": {"$ref": "#/$defs/artifactList"},
        "images": {"$ref": "#/$defs/artifactList"},
        "binaries": {"$ref": "#/$defs/artifactList"},
        "workflow": {"$ref": "#/$defs/artifactList"}
      }
    },
    "run_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top", "clock_port", "period_ns", "synthesis_seed", "threads"],
      "properties": {
        "top": {"type": "string", "minLength": 1},
        "clock_port": {"type": "string", "minLength": 1},
        "period_ns": {"type": "number", "exclusiveMinimum": 0},
        "synthesis_seed": {"type": "integer"},
        "threads": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "artifactList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
