{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "historical-defect-backfill-ledger-v1.schema.json",
  "title": "NPC RV64 historical defect backfill ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revision",
    "scope",
    "design_id",
    "depth_contract",
    "blocking_depths",
    "selected_id",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "npc-rv64-historical-defect-backfill-ledger-v1"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "design_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "depth_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["VD0", "VD1", "VD2", "VD3", "VD4"],
      "properties": {
        "VD0": {"type": "string", "minLength": 1},
        "VD1": {"type": "string", "minLength": 1},
        "VD2": {"type": "string", "minLength": 1},
        "VD3": {"type": "string", "minLength": 1},
        "VD4": {"type": "string", "minLength": 1}
      }
    },
    "blocking_depths": {
      "const": ["VD0", "VD1"]
    },
    "selected_id": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "hashArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "priority_rank",
        "title",
        "domain",
        "severity",
        "recurrence_risk",
        "observation_cost",
        "first_observed",
        "status",
        "validation_depth",
        "historical_symptom",
        "root_cause",
        "owner_paths",
        "source_artifacts",
        "current_evidence",
        "depth_basis",
        "required_backfill"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "priority_rank": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "domain": {
          "enum": [
            "rtl-liveness",
            "rtl-terminal-ownership",
            "verification-oracle",
            "evidence-binding"
          ]
        },
        "severity": {
          "enum": ["critical", "high", "medium", "low"]
        },
        "recurrence_risk": {
          "enum": ["high", "medium", "low"]
        },
        "observation_cost": {
          "enum": ["high", "medium", "low"]
        },
        "first_observed": {
          "type": "string",
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
        },
        "status": {
          "enum": ["SELECTED", "QUEUED", "BACKFILLED"]
        },
        "validation_depth": {
          "enum": ["VD0", "VD1", "VD2", "VD3", "VD4"]
        },
        "historical_symptom": {"type": "string", "minLength": 1},
        "root_cause": {"type": "string", "minLength": 1},
        "owner_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/hashArtifact"}
        },
        "current_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/hashArtifact"}
        },
        "depth_basis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "required_backfill": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
