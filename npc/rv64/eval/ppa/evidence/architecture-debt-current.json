        "rationale": "The cohort provides simulation observability and semihost EBREAK only; it does not advertise a RISC-V Debug Module, debug mode, halt or resume transport, or executable trigger action."
      },
      "SFENCE-SINVAL-G1": {
        "cohort_id": "full-core-single-hart-rv64-dual-issue-ooo-v1",
        "rationale": "The cohort serializes every accepted SFENCE.VMA and Svinval-family encoding into a conservative global translation and fetch invalidation; address-selective or ASID-selective invalidation is not a promised capability."
      },
      "WFI-G1": {
        "cohort_id": "full-core-single-hart-rv64-dual-issue-ooo-v1",
