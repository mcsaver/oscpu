#
# Automatically generated file; DO NOT EDIT.
# NEMU Configuration Menu
#
# CONFIG_ISA_x86 is not set
# CONFIG_ISA_mips32 is not set
CONFIG_ISA_riscv=y
# CONFIG_ISA_loongarch32r is not set
CONFIG_ISA="riscv64"
CONFIG_ISA64=y
CONFIG_RV64=y

#
# RISC-V ISA Extensions
#
CONFIG_RISCV_EXT_M=y
CONFIG_RISCV_EXT_A=y
CONFIG_RISCV_EXT_F=y
CONFIG_RISCV_EXT_D=y
CONFIG_RISCV_EXT_B=y
CONFIG_RISCV_EXT_C=y
CONFIG_RISCV_EXT_SDTRIG=y
# CONFIG_RISCV_CLINT_HOST_TIME is not set
# end of RISC-V ISA Extensions

CONFIG_TARGET_NATIVE_ELF=y
# CONFIG_TARGET_SHARE is not set
# CONFIG_TARGET_AM is not set

#
# Build Options
#
CONFIG_CC_GCC=y
# CONFIG_CC_GPP is not set
# CONFIG_CC_CLANG is not set
CONFIG_CC="gcc"
# CONFIG_CC_O0 is not set
# CONFIG_CC_O1 is not set
CONFIG_CC_O2=y
# CONFIG_CC_O3 is not set
CONFIG_CC_OPT="-O2"
# CONFIG_CC_LTO is not set
# CONFIG_PERFORMANCE is not set
# CONFIG_CC_DEBUG is not set
# CONFIG_CC_ASAN is not set
# end of Build Options

#
# CPU Performance Models
#
CONFIG_BPU=y
CONFIG_BPU_BTB_ENTRIES=128
CONFIG_BPU_BHT_ENTRIES=256
CONFIG_BPU_RAS_ENTRIES=16
CONFIG_BPU_COUNTER_BITS=2
CONFIG_BPU_COUNTER_INIT=1
CONFIG_BPU_GHR_BITS=0
# end of CPU Performance Models

#
# Testing and Debugging
#
CONFIG_WATCHPOINT=y
# CONFIG_BATCH_MODE is not set
# CONFIG_TRACE is not set
CONFIG_STATISTIC=y
CONFIG_RISCV_DEBUG_LOG=y
CONFIG_RISCV_FAULT_DEBUG_BUDGET=16
# CONFIG_RISCV_PROGRESS_DEBUG_LOG is not set
# CONFIG_RISCV_SYSCALL_DEBUG_LOG is not set
# CONFIG_DIFFTEST is not set
CONFIG_DIFFTEST_REF_PATH="none"
CONFIG_DIFFTEST_REF_NAME="none"
# end of Testing and Debugging

#
# Memory Configuration
#
CONFIG_MBASE=0x80000000
CONFIG_MSIZE=0x40000000
CONFIG_PC_RESET_OFFSET=0
CONFIG_PMEM_MALLOC=y
# CONFIG_PMEM_GARRAY is not set
# CONFIG_MEM_RANDOM is not set
CONFIG_CACHE=y
CONFIG_CACHE_STATISTIC=y
CONFIG_ICACHE_SIZE=4096
CONFIG_DCACHE_SIZE=4096
CONFIG_CACHE_LINE_SIZE=64
# end of Memory Configuration

CONFIG_DEVICE=y
# CONFIG_DEVICE_MAP_LEGACY is not set
CONFIG_HAS_SERIAL=y
# CONFIG_SERIAL_INPUT_FIFO is not set
# CONFIG_SERIAL_INPUT_STDIN is not set
CONFIG_HAS_TIMER=y
# CONFIG_HAS_KEYBOARD is not set
CONFIG_HAS_VGA=y
CONFIG_VGA_CTL_PORT=0x100
# CONFIG_VGA_SHOW_SCREEN is not set
CONFIG_VGA_SIZE_400x300=y
# CONFIG_VGA_SIZE_800x600 is not set
# CONFIG_HAS_AUDIO is not set
CONFIG_HAS_DISK=y
CONFIG_DISK_IMG_PATH=""
CONFIG_HAS_VIRTIO_RNG=y
CONFIG_HAS_VIRTIO_NET=y
CONFIG_HAS_GOLDFISH_RTC=y
CONFIG_HAS_SYSCON_RESET=y
CONFIG_SYSCON_POWEROFF_VALUE=0x5555
CONFIG_SYSCON_REBOOT_VALUE=0x7777
# CONFIG_HAS_SDCARD is not set
